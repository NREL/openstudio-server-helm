# Default values for openstudio-server.
# This is a YAML-formatted file.
# Declare variables to be passed into your templates.


global:
  provider:
    name: ""
    # Temporary migration toggle. Keep false unless upgrading legacy values
    # that still set provider.name instead of global.provider.name.
    allowLegacyName: false
  images:
    registry: ""
    org: "nrel"
    serverRepository: "openstudio-server"
    rserveRepository: "openstudio-rserve"
    tag: "3.10.0"

cluster:
  name: "openstudio-server"

autoscaler:
  # Defaults to enabled on AWS and disabled on other providers unless explicitly set.
  # enabled: true
  # For OpenStack, enable autoscaler and provide one or more node groups.
  # openstackNodeGroups:
  #   - name: web-group
  #     min: 1
  #     max: 5
  #   - name: worker-group
  #     min: 1
  #     max: 50
  openstackNodeGroups: []
  extraArgs: []

priorityClasses:
  enabled: true
  create: true
  highName: "high-priority"
  lowName: "low-priority"

secrets:
  # Primary path: pre-create this secret once and reference it.
  existingSecret: "openstudio-app-secrets"
  # Optional install-time guard for connected clusters.
  # When true, rendering fails if existingSecret is not found in the release namespace.
  validateExistingSecret: false
  # Alternate path. Set to true only if you intentionally want chart-managed secret creation.
  create: false
  nameOverride: ""
  keys:
    dbUsername: "db-username"
    dbPassword: "db-password"
    redisPassword: "redis-password"
    webSecret: "web-secret-key"

nfs-server-provisioner:
  persistence:
    enabled: true
    # Backend storage for the in-cluster NFS server (nfs-pvc-data).
    # Keep nfs_pvc.storage below this value to avoid NFS provisioning failures.
    # OpenStack preflight (required): ensure this + db.persistence.size +
    # redis.persistence.size + existing Cinder usage remains below your quota.
    size: 550Gi
  # Pull from the local zot mirror endpoint instead of Docker Hub.
  image:
    repository: "erezsh2/nfs-provisioner"
    tag: "v2.3.0"
  storageClass:
    allowVolumeExpansion: false
    mountOptions:
      - vers=4
db:
  # Required when secrets.create=true.
  username: ""
  password: ""
  container:
    image: "library/mongo@sha256:a40f777b87a077a8a4801368aa17629e575413d6567872492135e26692499905"
    imagePullPolicy: "IfNotPresent"
    resources:
      requests:
        cpu: 1
        memory: "4Gi"
  persistence:
    size: 200Gi

nfs_pvc:
  # Frontend shared RWX claim consumed by web/rserve/background pods.
  # Keep this below nfs-server-provisioner.persistence.size (recommended 85-95%).
  storage: "500Gi"


redis:
  # Required when secrets.create=true.
  password: ""
  # Optional explicit Redis URI for REDIS_URL.
  # Use this when credentials include URI-reserved characters.
  url: ""
  container:
    image: "library/redis@sha256:94fb31b765189935ffd5f0503ce496bee4404499cbcfa7f8d67020bfbed2a345"
    imagePullPolicy: "IfNotPresent"
    resources:
      requests:
        cpu: 0.25
        memory: "1Gi"
  persistence:
    size: 200Gi

rserve:
  number_of_workers: "1"
  container:
    imagePullPolicy: "IfNotPresent"
    resources:
      requests:
        cpu: 1
        memory: "2Gi"

rserve_svc:
  {}

web_background:
  replicas: 1
  container:
    imagePullPolicy: "IfNotPresent"
    resources:
      requests:
        cpu: 0.25
        memory: "512Mi"

web:
  # Required when secrets.create=true.
  secret_key_value: ""
  # passenger_max_request_queue_size: "1600"
  # Use this formula (1024 * memory of web pod in Gi * 0.75) / memory per passenger process
  # passenger_max_pool_size: "21"
  # This value is typically between 150 and 400, find this by ssh into web pod and doing `passenger-status`
  passenger_memory_per_process: 250
  container:
    imagePullPolicy: "IfNotPresent"
    resources:
      requests:
        cpu: 1
        memory: "2Gi"

# For this to work and have more than 1 web pod we'll need to implement
# a distributed file locking scheme such a https://github.com/antirez/redlock-rbs
# as even with using NFS via sync it cannot guarantee file locking using multiple clients
web_hpa:
  minReplicas: 1
  maxReplicas: 1
  targetCPUUtilizationPercentage: 50

web_svc:
  {}

worker:
  queues: "simulations,requeued"
  container:
    imagePullPolicy: "IfNotPresent"
    resources:
      requests:
        cpu: 700m
        memory: "900Mi"
    terminationGracePeriodSeconds: 5200

worker_hpa:
  minReplicas: 2
  maxReplicas: 20
  targetCPUUtilizationPercentage: 50
  stabilizationWindowSeconds: 3600

worker_autoscaling:
  mode: "hpa"
  keda:
    pollingIntervalSeconds: 15
    cooldownPeriodSeconds: 300
    redisAddress: ""
    queueNames:
      - simulations
      - requeued
    queueLengthPerWorker: 1
    activationQueueLength: 1
    enableCpuTrigger: true
    advanced:
      restoreToOriginalReplicaCount: false

hooks:
  preDeleteCleanup:
    enabled: true
