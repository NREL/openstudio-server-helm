# Default values for openstudio-server.
# This is a YAML-formatted file.
# Declare variables to be passed into your templates.


# Set to google, aws or azure
provider:
  name: ""

cluster:
  name: "openstudio-server"

nfs-server-provisioner:
  persistence:
    enabled: true
    storageClass: "ssd"
    size: 550Gi
  storageClass:
    allowVolumeExpansion: false
    mountOptions:
      - vers=4
      - sync
db:
  name:  "db"
  label: "db"
  username: "openstudio"
  password: "openstudio"
  container:
    name: "mongo-db"
    image: "mongo:6.0.7"
    resources:
      requests:
        cpu: 1
        memory: "4Gi"
    ports:
      db_port: 27017
  persistence:
    enabled: true
    storageClass: "ssd"
    size: 200Gi
    accessModes:
      - "ReadWriteOnce"

load_balancer:
  name: "ingress-load-balancer"
  externalTrafficPolicy: "Local"
  label: "web"
  internal: false
  ports:
    http_name: "http"
    http_port: 80
    http_protocol: "TCP"
    https_name: "https"
    https_port: 443
    https_protocol: "TCP"

nfs:
  name: "nfs"

nfs_pvc:
  name: "nfs-pvc"
  accessModes:
    - "ReadWriteMany"
  storage_class: ""
  storage: "500Gi"


redis:
  name: "redis"
  label: "redis"
  password: "openstudio"
  maxclients: 10000
  container:
    name: "redis"
    image: "redis:6.0.9"
    resources:
      requests:
        cpu: 0.25
        memory: "1Gi"
    port: 6379
  persistence:
    enabled: true
    storageClass: "ssd"
    size: 200Gi
    accessModes:
      - "ReadWriteOnce"

redis_svc:
  name: "queue"
  label: "redis"
  port: 6379
  url: "redis://:openstudio@queue:6379"

rserve:
  name: "rserve"
  label: "rserve"
  number_of_workers: "1"
  container:
    name: "rserve"
    image: "nrel/openstudio-rserve:3.8.0-1"
    resources:
      requests:
        cpu: 1
        memory: "2Gi"

rserve_svc:
  name: "rserve"
  label: "rserve"
  port: 6311

web_background:
  name: "web-background"
  label: "web-background"
  replicas: 1
  container:
    name: "web-background" 
    image: "nrel/openstudio-server:3.8.0-1"
    resources:
      requests:
        cpu: 0.25
        memory: "512Mi"

web:
  name: "web"
  label: "web"
  secret_key_value: "c4ab6d293e4bf52ee92e8dda6e16dc9b5448d0c5f7908ee40c66736d515f3c29142d905b283d73e5e9cef6b13cd8e38be6fd3b5e25d00f35b259923a86c7c473"
  # Image for the init container that waits for the db to accept connections
  # before the web container starts. Any image with a POSIX shell + nc.
  initContainer:
    image: "alpine"
  # MAX_POOL (passenger_max_pool_size) is derived automatically in
  # templates/web/web-deploy.yaml -- you only size the container:
  #
  #   memory source : web.container.resources.limits.memory if set, else
  #                   requests.memory
  #   pool          = floor((memory_MiB - passenger_memory_reserve_mb)
  #                         / passenger_memory_per_process), minimum 2
  #
  # e.g. a 60Gi limit => floor((61440 - 1500) / 1100) = 54 processes.
  # Memory footprint of ONE LOADED Passenger Rails process (MB), measured via
  # `passenger-status` RSS on a production cluster at ~950 analyses: five
  # sampled processes ranged 1031-1160 MB. The previous default of 250 was an
  # idle-process estimate; it derived pools up to 4x larger than the pod could
  # actually hold (590 processes x 1.1 GB on a ~315 GB node) and flooded
  # MongoDB with concurrent client connections.
  passenger_memory_per_process: 1100
  # Memory (MB) reserved inside the web container for everything that is NOT a
  # Passenger app process: nginx + Passenger core plus the analysis_wrappers
  # resque worker (~250 MB measured). Subtracted from container memory before
  # dividing by passenger_memory_per_process. Rarely needs changing.
  passenger_memory_reserve_mb: 1500
  container:
    name: "web"
    image: "nrel/openstudio-server:3.8.0-1"
    resources:
      requests:
        cpu: 1
        memory: "2Gi"
    port:
     http: 80
     https: 443

# For this to work and have more than 1 web pod we'll need to implement
# a distributed file locking scheme such a https://github.com/antirez/redlock-rbs
# as even with using NFS via sync it cannot guarantee file locking using multiple clients
web_hpa:
  name: "web"
  minReplicas: 1
  maxReplicas: 1
  targetCPUUtilizationPercentage: 50

web_svc:
  name: "web"
  label: "web"
  ports:
    http: 80
    https: 443

worker:
  name: "worker"
  label: "worker"
  container:
    name: "worker"
    image: "nrel/openstudio-server:3.8.0-1"
    resources:
      requests:
        cpu: 700m
        memory: "900Mi"
    terminationGracePeriodSeconds: 60

worker_hpa:
  name: "worker"
  minReplicas: 2
  maxReplicas: 20
  targetCPUUtilizationPercentage: 50
  stabilizationWindowSeconds: 3600



