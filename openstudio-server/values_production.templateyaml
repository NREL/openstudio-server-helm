# Production values for openstudio-server.
# This is a YAML-formatted file optimized for production workloads.
# Declare variables to be passed into your templates.

global:
  provider:
    name: "openstack"
    # Temporary migration toggle. Keep false unless upgrading legacy values
    # that still set provider.name instead of global.provider.name.
    allowLegacyName: false
  images:
    registry: ""
    org: "nrel"
    serverRepository: "openstudio-server"
    rserveRepository: "openstudio-rserve"
    tag: "3.10.0"

cluster:
  name: "openstudio-server-prod"

autoscaler:
  # Defaults to enabled on AWS and disabled on other providers unless explicitly set.
  # enabled: true
  # For OpenStack, enable autoscaler and provide one or more node groups.
  # openstackNodeGroups:
  #   - name: web-group
  #     min: 1
  #     max: 5
  #   - name: worker-group
  #     min: 1
  #     max: 50
  openstackNodeGroups: []
  extraArgs: []

priorityClasses:
  enabled: true
  create: true
  highName: "high-priority"
  lowName: "low-priority"

secrets:
  # Primary path: pre-create this secret once and reference it.
  existingSecret: "openstudio-app-secrets"
  # Optional install-time guard for connected clusters.
  # When true, rendering fails if existingSecret is not found in the release namespace.
  validateExistingSecret: false
  # Alternate path. Set to true only if you intentionally want chart-managed secret creation.
  create: false
  nameOverride: ""
  keys:
    dbUsername: "db-username"
    dbPassword: "db-password"
    redisPassword: "redis-password"
    webSecret: "web-secret-key"

# About scaling: These values are tuned for deployments targeting ~2,000-5,000 worker pods.
# Each bottleneck category is annotated with its scaling ceiling.

# NFS Server Provisioner - Increased storage for production workloads
nfs-server-provisioner:
  persistence:
    enabled: true
    # Backend storage for the in-cluster NFS server (nfs-pvc-data).
    # Keep nfs_pvc.storage below this value to avoid NFS provisioning failures.
    # OpenStack preflight (required): ensure this + db.persistence.size +
    # redis.persistence.size + existing Cinder usage remains below your quota.
    size: 1Ti  # Sized for no-pruning retention and high worker throughput
  # Pull from the local zot mirror endpoint instead of Docker Hub.
  image:
    repository: "erezsh2/nfs-provisioner"
    tag: "v2.3.0"
  storageClass:
    allowVolumeExpansion: true  # Enable expansion for future growth
    mountOptions:
      - vers=4

# Database - Enhanced for production
# 🔴 CRITICAL B2: Single MongoDB instance — ceiling ~3k-5k workers.
# Beyond this ceiling, deploy MongoDB replica set (3+ pods with primary/secondary/arbiter).
db:
  # Required when secrets.create=true.
  username: ""
  password: ""
  container:
    image: "library/mongo:6.0.7"
    imagePullPolicy: "IfNotPresent"
    resources:
      requests:
        cpu: 4          # Increased from 2 for 2k+ worker workloads
        memory: "22Gi"  # Increased from 8Gi for WiredTiger cache headroom
  persistence:
    # Keep MongoDB on block storage. Do NOT switch to nfs:
    # WiredTiger may fail with "Operation not permitted" when creating collections.
    storageClass: "csi-cinder"
    size: 20Gi        # Increased from 2Gi for production data

# NFS PVC - Increased storage for production
# 🔴 CRITICAL B3: Single NFS server — ceiling ~1k-2k workers.
# Beyond this ceiling, migrate simulation artifact storage to S3/MinIO.
nfs_pvc:
  # Frontend shared RWX claim consumed by web/rserve/background pods.
  # Keep this below nfs-server-provisioner.persistence.size (recommended 85-95%).
  storage: "900Gi"

# Redis - Enhanced for production
# 🔴 CRITICAL B1: Single Redis instance — ceiling ~2k-3k workers.
# The single-threaded event loop becomes CPU-saturated at ~10k concurrent connections.
# Beyond this ceiling, deploy Redis Sentinel or Redis Cluster.
redis:
  # Required when secrets.create=true.
  password: ""
  # Optional explicit Redis URI for REDIS_URL.
  # Use this when credentials include URI-reserved characters.
  url: ""
  container:
    image: "library/redis:6.0.9"
    imagePullPolicy: "IfNotPresent"
    resources:
      requests:
        cpu: 8          # Increased from 0.5: 10k BRPOP connections need CPU headroom
        memory: "16Gi"  # Increased from 2Gi: AOF rewrite + queue data in memory
  persistence:
    # Keep Redis on block storage; reserve nfs for shared artifacts only.
    storageClass: "csi-cinder"
    size: 20Gi         # Increased from 5Gi for deep queue buffers
  config:
    maxclients: 50000  # 10k workers + 96 bg workers + headroom (B1)
    tcpBacklog: 511
    timeoutSeconds: 0
    appendfsync: "everysec"  # Balance durability vs. latency (B13)
    save: ""                 # Disable auto RDB saves to avoid fork() spikes (B13)

# RServe - Enhanced for production
rserve:
  number_of_workers: "2"  # Increased from 1 for better R processing
  container:
    imagePullPolicy: "IfNotPresent"
    resources:
      requests:
        cpu: 2          # Increased from 1 for better R performance
        memory: "4Gi"   # Increased from 2Gi for larger R workloads

rserve_svc:
  {}

# Web Background - Enhanced for production
# 🟠 HIGH B5: Queue pipeline bottleneck — 96 workers (8×12) can sustain ~5k+ consumers.
web_background:
  replicas: 8           # Increased from 2: more simulation producers (B5)
  workerCount: 12       # Increased from 6: each pod runs 12 Resque workers
  container:
    imagePullPolicy: "IfNotPresent"
    resources:
      requests:
        cpu: 4          # Increased from 0.5 for background/analysis processing
        memory: "8Gi"   # Increased from 1Gi for analysis payloads

# Web background HPA — autoscale 8→32 based on memory utilization
web_background_hpa:
  enabled: true
  minReplicas: 8
  maxReplicas: 32
  targetMemoryUtilizationPercentage: 70
  stabilizationWindowSeconds: 300

# Web - Enhanced for production with proper passenger configuration
# 🔴 CRITICAL B4: Web Passenger connection pool — ceiling ~5k-7k workers.
# The 85:1 connection-to-process ratio means HTTP queueing under load.
# For >7k workers, enable distributed locking and scale web to 3+ replicas.
web:
  # Required when secrets.create=true.
  secret_key_value: ""
  # Use this formula (1024 * memory of web pod in Gi * 0.75) / memory per passenger process
  passenger_memory_per_process: 250          # Keep existing optimized value
  container:
    imagePullPolicy: "IfNotPresent"
    resources:
      requests:
        cpu: 6          # Increased from 2 for 10k worker callback handling
        memory: "50Gi"  # Increased from 8Gi for Passenger process pool

# Web HPA - Configured for production scaling
# Enable distributed locking before scaling beyond 1 replica.
web_hpa:
  minReplicas: 2        # Increased from 1 for baseline redundancy
  maxReplicas: 6        # Increased from 1 for callback load distribution
  targetCPUUtilizationPercentage: 70
  # Distributed locking prevents race conditions in multi-web deployments.
  # Requires the application to implement Redis redlock (B4).
  distributedLocking:
    enabled: false      # Set true only after application-level redlock is validated
    lockMode: "redis"   # "redis" | "db"
    lockTTLSeconds: 30
    retryIntervalMs: 100

web_svc:
  {}

# Worker - Enhanced for production
worker:
  queues: "simulations,requeued"
  # Distribute workers across nodes to avoid single-node saturation (B10)
  topologySpread:
    enabled: true
    maxSkew: 1
    topologyKey: "kubernetes.io/hostname"
    whenUnsatisfiable: ScheduleAnyway
  # Spread pods across nodes (preferred) to reduce blast radius (B10)
  antiAffinity:
    enabled: true
    type: "preferred"
    topologyKey: "kubernetes.io/hostname"
  # Protect against voluntary disruptions during rolling updates (B10)
  podDisruptionBudget:
    enabled: true
    minAvailable: 1
  container:
    imagePullPolicy: "IfNotPresent"
    resources:
      requests:
        cpu: "400m"     # Reduced from 1: better pod density (~2 per 1-core slice) (B8)
        memory: "1Gi"   # Reduced from 2Gi: observed peak 1.3GB with headroom (B8)
      limits:
        cpu: 2          # Cap burst to prevent node OOM (B8)
        memory: "2Gi"   # Hard limit for memory safety (B8)
    # PreStop reduced from 5200s to 600s for faster scale-in (B12)
    terminationGracePeriodSeconds: 600
    preStop:
      enabled: true
      maxWaitSeconds: 600       # 10 min max drain (was 85 min)
      pollIntervalSeconds: 10   # Faster detection of job completion (was 30s)
      signal: 3                 # SIGQUIT
      fastTerminateSeconds: 120 # Bounded graceful wait before deterministic TERM/KILL fallback
      forceTerminateGraceSeconds: 20
      forceKillEnabled: true

# Worker HPA - Optimized for production workloads
worker_hpa:
  minReplicas: 5        # Increased from 2 for baseline production capacity
  maxReplicas: 800      # Safety cap to limit churn while node-group health is unstable
  targetCPUUtilizationPercentage: 60
  stabilizationWindowSeconds: 1800

worker_autoscaling:
  mode: "keda-hybrid"   # Changed from "hpa": queue-depth + CPU hybrid (B6)
  keda:
    pollingIntervalSeconds: 10   # React to queue backlog within 10s (was 15)
    cooldownPeriodSeconds: 300
    redisAddress: ""
    queueNames:
      - simulations
      - requeued
    queueLengthPerWorker: 1
    activationQueueLength: 1
    enableCpuTrigger: false
    advanced:
      restoreToOriginalReplicaCount: false

# Image prepull — enabled by default for 10k+ worker fleets (B9)
prepull:
  enabled: true
  role: "worker"            # Pre-pull on worker nodes
  spreadSeconds: 600        # Stagger across nodes to avoid registry stampede
  warmMode: "once"          # Pull once on node startup
  intervalSeconds: 3600     # Re-check every hour
  failOnAnyPullError: true  # Make pull failures visible in pod status
  includeRserve: true
  includeWebInit: false
  additionalImages: []

hooks:
  preDeleteCleanup:
    enabled: true
