# OpenStack authentication (required)
TF_VAR_openstack_user_name="your-openstack-username"
TF_VAR_openstack_password="your-openstack-password"
TF_VAR_openstack_auth_url="https://your-openstack-api.example.com:5000"
TF_VAR_openstack_tenant_name="your-openstack-project-name"

# OpenStack identity/project context (recommended)
TF_VAR_openstack_user_domain_name="Default"
TF_VAR_openstack_project_domain_id="default"
TF_VAR_openstack_project_id="your-openstack-project-id"
TF_VAR_openstack_region="RegionOne"

# Infrastructure inputs (required by Terraform unless provided in tfvars)
TF_VAR_key_pair="your-openstack-keypair-name"
# Replace with your actual SSH public key (for example: cat ~/.ssh/id_rsa.pub)
TF_VAR_public_key="ssh-rsa AAAA... your-email@example.com"

# Optional network hardening (recommended)
# Replace these example CIDRs with your real trusted source IP/CIDR ranges.
TF_VAR_admin_access_cidr="203.0.113.10/32"
TF_VAR_k8s_api_access_cidr="203.0.113.10/32"
TF_VAR_nodeport_access_cidr="0.0.0.0/0"

# Optional sizing overrides
TF_VAR_master_flavor="CS.Wee"
TF_VAR_web_flavor="CS.2XMedium"
TF_VAR_worker_flavor="CM.XLarge"
