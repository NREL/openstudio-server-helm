usage() {
  cat <<'EOF'
Usage:
  scripts/openstudio-reliability [options]

Modes (default: check):
  --mode check            Read-only reliability preflight checks.
  --mode snapshot         Export queue/job snapshots for incident forensics.
  --mode review-non-completed
                          Read-only review of non-completed analyses with blocker summary.
  --mode scale-baseline   Repeated snapshots + timeline for scale-up latency analysis.
  --mode ceiling-probe    Report-only quiet-window gate for next worker ceiling step.
  --mode reconcile-helm   Reconcile Helm failed state (requires --apply).
  --mode recover-stuck    Recover stuck analysis state (requires --apply).

Options:
  -n, --namespace <ns>    Kubernetes namespace (default: openstudio-server)
  -r, --release <name>    Helm release name (default: openstudio-server)
  -c, --chart <path>      Chart path for reconcile mode (default: ./openstudio-server)
      --snapshot-dir <d>  Output directory for snapshot mode.
      --apply             Required for mutating mode reconcile-helm.
      --no-strict         Continue check mode even when one probe fails.
      --allow-chart-apply Allow reconcile mode to use local chart path for upgrade.
      --allow-non-conflict-reconcile
                          Allow reconcile even if helm status is not a conflict failure.
      --stale-minutes <m> Stale cutoff for diagnostics/recovery (default: 70).
      --lock-ttl-seconds <s>
                          Redis lock TTL for recover mode (default: 1800).
      --duration-seconds <s>
                          Duration for scale-baseline mode (default: 1200).
      --interval-seconds <s>
                          Sampling interval for scale-baseline mode (default: 30).
      --quiet-window-seconds <s>
                          Observation window for ceiling-probe mode (default: 900).
      --quiet-interval-seconds <s>
                          Sampling interval for ceiling-probe mode (default: 30).
      --probe-step-replicas <n>
                          Suggested maxReplicas increase when gates pass (default: 50).
      --probe-max-replicas-limit <n>
                          Optional hard upper bound for suggested maxReplicas (default: 1200).
      --event-window-seconds <s>
                          Warning-event lookback window for gate signals (default: 900).
      --event-hard-threshold <n>
                          Sustained-count threshold for hard warning-event blockers (default: 3).
      --event-soft-threshold <n>
                          Sustained-count threshold for soft warning-event blockers (default: 5).
      --problem-pod-threshold <n>
                          Problem pod count required before pod health blocks scale-up (default: 3).
      --calico-qos-threshold <n>
                          calico-node non-Guaranteed pod count required before QoS drift blocks scale-up (default: 3).
      --stale-terminating-minutes <m>
                          Count only terminating pods older than this age (default: 10).
      --probe-diagnostics  Emit per-sample blocker diagnostics during ceiling-probe mode.
      --snapshot-on-block
                          Capture one snapshot when blocker samples become persistent in ceiling-probe mode.
      --cleanup-failed-worker-pods
                          Delete failed/evicted worker pod artifacts during scale-baseline and ceiling-probe modes (requires --apply).
      --cleanup-max-delete <n>
                          Max failed/evicted worker pods deleted per cleanup pass (default: 200).
      --cleanup-stale-terminating-worker-pods
                          Delete stale terminating worker pods during ceiling-probe mode (requires --apply).
      --cleanup-stale-max-delete <n>
                          Max stale terminating worker pods deleted per cleanup pass (default: 100).
      --analysis-id <id>  Optional analysis ID for focused lifecycle diagnostics.
  -h, --help              Show this help.

Examples:
  scripts/openstudio-reliability --mode check
  scripts/openstudio-reliability --mode snapshot --snapshot-dir /tmp/os-incident
  scripts/openstudio-reliability --mode review-non-completed --stale-minutes 70
  scripts/openstudio-reliability --mode check --analysis-id ff690a50-56e4-4d88-9bf0-0e680326dbc7
  scripts/openstudio-reliability --mode ceiling-probe --quiet-window-seconds 900 --probe-step-replicas 50
  scripts/openstudio-reliability --mode reconcile-helm --apply --allow-chart-apply
  scripts/openstudio-reliability --mode recover-stuck --apply
EOF
}

log() { echo "[INFO] $*"; }
warn() { echo "[WARN] $*" >&2; }
die() { echo "[ERROR] $*" >&2; exit 1; }

require_bin() {
  command -v "$1" >/dev/null 2>&1 || die "Missing required binary: $1"
}

kube_probe() {
  local desc=$1
  shift
  if "$@"; then
    return 0
  fi
  if [[ "$STRICT" == "true" ]]; then
    die "${desc} failed"
  fi
  warn "${desc} failed"
  return 0
}

get_single_pod_by_label() {
  local selector=$1
  mapfile -t pods < <(kubectl -n "$NAMESPACE" get pods -l "$selector" -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}')
  if [[ ${#pods[@]} -eq 0 ]]; then
    die "No pods found for selector: $selector"
  fi
  if [[ ${#pods[@]} -gt 1 ]]; then
    die "Selector matched multiple pods (${#pods[@]}): $selector"
  fi
  echo "${pods[0]}"
}

get_single_running_pod_by_label() {
  local selector=$1
  # The status.phase field selector is not supported by all API servers; filter client-side via jq.
  mapfile -t pods < <(
    kubectl -n "$NAMESPACE" get pods -l "$selector" -o json 2>/dev/null \
    | jq -r '.items[] | select(.status.phase == "Running") | .metadata.name' || true
  )
  if [[ ${#pods[@]} -eq 0 ]]; then
    die "No running pods found for selector: $selector"
  fi
  if [[ ${#pods[@]} -gt 1 ]]; then
    warn "Selector matched multiple running pods (${#pods[@]}): $selector; using ${pods[0]}"
  fi
  echo "${pods[0]}"
}

get_single_pod_by_name_substring() {
  local pattern=$1
  mapfile -t pods < <(kubectl -n "$NAMESPACE" get pods -o name | grep "$pattern" | sed 's#pod/##' || true)
  if [[ ${#pods[@]} -eq 0 ]]; then
    die "No pods found matching name substring: $pattern"
  fi
  if [[ ${#pods[@]} -gt 1 ]]; then
    die "Name substring matched multiple pods (${#pods[@]}): $pattern"
  fi
  echo "${pods[0]}"
}

require_release_exists() {
  helm status "$RELEASE" -n "$NAMESPACE" >/dev/null
}

get_redis_pod() {
  get_single_running_pod_by_label "app=redis,release=${RELEASE}"
}

get_web_pod() {
  get_single_running_pod_by_label "app=web,release=${RELEASE}"
}

get_worker_hpa_name() {
  if kubectl -n "$NAMESPACE" get hpa worker >/dev/null 2>&1; then
    echo "worker"
    return 0
  fi

  if kubectl -n "$NAMESPACE" get hpa "${RELEASE}-worker" >/dev/null 2>&1; then
    echo "${RELEASE}-worker"
    return 0
  fi

  mapfile -t hpa_names < <(
    kubectl -n "$NAMESPACE" get hpa -o json 2>/dev/null | jq -r '
      .items[]
      | select(.spec.scaleTargetRef.kind == "Deployment" and .spec.scaleTargetRef.name == "worker")
      | .metadata.name
    '
  )

  if [[ ${#hpa_names[@]} -eq 1 ]]; then
    echo "${hpa_names[0]}"
    return 0
  fi

  if [[ ${#hpa_names[@]} -eq 0 ]]; then
    die "No worker HPA found in namespace ${NAMESPACE}"
  fi

  die "Multiple worker HPAs found in namespace ${NAMESPACE}: ${hpa_names[*]}"
}

reconcile_is_conflict_failure() {
  local status_text
  status_text="$(helm status "$RELEASE" -n "$NAMESPACE")"
  grep -q "STATUS: failed" <<<"$status_text" || return 1
  grep -Eq "conflict occurred while applying object|Apply failed with .* conflict" <<<"$status_text"
}

read_worker_state() {
  local worker_hpa
  worker_hpa="$(get_worker_hpa_name)"
  kube_probe "worker HPA read" kubectl -n "$NAMESPACE" get hpa "$worker_hpa" -o wide
  kube_probe "worker deployment read" kubectl -n "$NAMESPACE" get deploy worker -o wide
}

read_helm_state() {
  kube_probe "helm status read" bash -lc "helm status \"$RELEASE\" -n \"$NAMESPACE\" | sed -n '1,20p'"
}

read_nfs_usage() {
  local nfs_pod
  nfs_pod="$(get_single_pod_by_name_substring 'nfs-server-provisioner')"

  log "NFS usage from pod ${nfs_pod}"
  kube_probe "nfs /export usage read" kubectl -n "$NAMESPACE" exec "$nfs_pod" -- df -P -h /export
}

read_redis_queues() {
  local redis_pod
  redis_pod="$(get_redis_pod)"

  log "Redis queue depths from pod ${redis_pod}"
  kube_probe "redis queue depths read" kubectl -n "$NAMESPACE" exec "$redis_pod" -- sh -lc '
    PW="${REDIS_PASSWORD:-}"
    AUTH=""
    if [ -n "$PW" ]; then AUTH="-a $PW --no-auth-warning"; fi
    for q in analyses analysis_wrappers simulations background requeued; do
      printf "%s=" "$q"
      redis-cli $AUTH LLEN "resque:queue:$q"
    done
    printf "failed="
    redis-cli $AUTH LLEN resque:failed
  '
}

collect_failed_queue_triage() {
  local redis_pod=$1
  local out_dir=$2
  local raw_file triage_tsv signature_tsv analysis_tsv triage_md
  local sample_limit end_index
  sample_limit="$FAILED_QUEUE_TRIAGE_SAMPLE_LIMIT"
  [[ "$sample_limit" =~ ^[0-9]+$ ]] || sample_limit=500
  (( sample_limit >= 1 )) || sample_limit=1
  end_index=$((sample_limit - 1))

  raw_file="${out_dir}/failed_queue_entries.raw.jsonl"
  triage_tsv="${out_dir}/failed_queue_entries.tsv"
  signature_tsv="${out_dir}/failed_queue_signature_counts.tsv"
  analysis_tsv="${out_dir}/failed_queue_analysis_counts.tsv"
  triage_md="${out_dir}/failed_queue_triage.md"

  kubectl -n "$NAMESPACE" exec "$redis_pod" -- sh -lc "
    PW=\"\${REDIS_PASSWORD:-}\"
    AUTH=\"\"
    [ -n \"\$PW\" ] && AUTH=\"-a \$PW --no-auth-warning\"
    redis-cli --raw \$AUTH LRANGE resque:failed 0 ${end_index}
  " > "$raw_file" 2>/dev/null || : > "$raw_file"

  jq -R -s '
    split("\n")
    | map(select(length > 0))
    | to_entries
    | map(
        . as $entry
        | ($entry.value | try fromjson catch {parse_error: true, raw: $entry.value}) as $job
        | ($job.payload.class // "unknown") as $payload_class
        | ($job.exception // $job.error_class // "unknown") as $exception_class
        | (($job.error // $job.exception_message // "" | tostring) | split("\n")[0]) as $error_line
        | (($job.payload.args // []) | tostring) as $args_text
        | (
            ($job.payload.args // []) as $args
            | [
                ($job.analysis_id // ""),
                ($job.analysis // ""),
                ($args[0] | if type == "object" then (.analysis_id // .id // "") elif type == "string" then . else "" end),
                ($args[1] | if type == "object" then (.analysis_id // .id // "") elif type == "string" then . else "" end)
              ]
            | map(select(type == "string" and length > 0))
            | if length > 0 then .[0] else (try ($args_text | capture("(?<id>[0-9a-fA-F-]{36})").id) catch "") end
          ) as $analysis_id
        | (($payload_class + "|" + $exception_class + "|" + ($error_line | .[0:140])) | gsub("[[:space:]]+"; " ")) as $signature
        | (($payload_class + " " + $exception_class + " " + $error_line) | ascii_downcase) as $retry_text
        | (if ($retry_text | test("timeout|timed out|connection reset|econn|temporar|503|502|429|rate limit|unavailable"))
           then "safe_retry_candidate"
           elif ($retry_text | test("argumenterror|nomethoderror|undefined method|validation|not found|mongo::auth::unauthorized|syntaxerror"))
           then "manual_intervention"
           else "needs_manual_review"
           end) as $retryability
        | {
            failed_index: $entry.key,
            failed_at: ($job.failed_at // ""),
            retried_at: ($job.retried_at // ""),
            payload_class: $payload_class,
            exception_class: $exception_class,
            error_line: $error_line,
            signature: $signature,
            analysis_id: $analysis_id,
            retryability: $retryability
          }
      )
  ' "$raw_file" > "${out_dir}/failed_queue_triage.json"

  jq -r '
    ["failed_index","failed_at","retried_at","payload_class","exception_class","retryability","analysis_id","signature","error_line"],
    (.[] | [
      (.failed_index | tostring),
      .failed_at,
      .retried_at,
      .payload_class,
      .exception_class,
      .retryability,
      .analysis_id,
      .signature,
      .error_line
    ])
    | @tsv
  ' "${out_dir}/failed_queue_triage.json" > "$triage_tsv"

  jq -r '
    ["signature","count","retryability_hint"],
    (
      sort_by(.signature)
      | group_by(.signature)
      | map({
          signature: .[0].signature,
          count: length,
          retryability_hint: (
            . | group_by(.retryability) | max_by(length) | .[0].retryability
          )
        })
      | sort_by(-.count, .signature)
      | .[]
      | [.signature, (.count | tostring), .retryability_hint]
    )
    | @tsv
  ' "${out_dir}/failed_queue_triage.json" > "$signature_tsv"

  jq -r '
    ["analysis_id","count","top_retryability_hint"],
    (
      map(select((.analysis_id | length) > 0))
      | sort_by(.analysis_id)
      | group_by(.analysis_id)
      | map({
          analysis_id: .[0].analysis_id,
          count: length,
          top_retryability_hint: (
            . | group_by(.retryability) | max_by(length) | .[0].retryability
          )
        })
      | sort_by(-.count, .analysis_id)
      | .[]
      | [.analysis_id, (.count | tostring), .top_retryability_hint]
    )
    | @tsv
  ' "${out_dir}/failed_queue_triage.json" > "$analysis_tsv"

  {
    echo "# Failed Queue Triage"
    echo
    echo "- Sample limit: ${sample_limit}"
    echo "- Entries captured: $(jq 'length' "${out_dir}/failed_queue_triage.json")"
    echo
    echo "## Top signatures"
    echo
    if [[ "$(jq 'length' "${out_dir}/failed_queue_triage.json")" == "0" ]]; then
      echo "- None"
    else
      jq -r '
        sort_by(.signature)
        | group_by(.signature)
        | map({signature: .[0].signature, count: length})
        | sort_by(-.count, .signature)
        | .[0:10]
        | .[]
        | "- \(.signature) => \(.count)"
      ' "${out_dir}/failed_queue_triage.json"
    fi
    echo
    echo "## Operator action map"
    echo
    echo "- safe_retry_candidate: replay is usually safe after queue/core/worker blockers are clear."
    echo "- manual_intervention: inspect payload + app logs before replay; likely code/data issue."
    echo "- needs_manual_review: investigate first occurrence, then decide replay vs quarantine."
  } > "$triage_md"
}

collect_non_completed_job_inventory() {
  local web_pod=$1
  local out_dir=$2
  local raw_file inventory_json inventory_tsv

  raw_file="${out_dir}/non_completed_jobs_raw.json"
  inventory_json="${out_dir}/non_completed_job_inventory.json"
  inventory_tsv="${out_dir}/non_completed_job_inventory.tsv"

  kubectl -n "$NAMESPACE" exec "$web_pod" -- bash -lc "
    cd /opt/openstudio/server
    STALE_MINUTES='${STALE_THRESHOLD_MINUTES}' bundle exec rails runner '
      require %q(json)
      stale = ENV.fetch(%q(STALE_MINUTES), %q(70)).to_i
      now = Time.now
      cutoff = now - stale.minutes
      analyses = Analysis.all.select { |analysis| analysis.status.to_s != %q(completed) }
      analysis_status_map = Hash[(analyses.map { |analysis| [analysis.id.to_s, analysis.status.to_s] })]
      jobs = Job.where(:status.ne => %q(completed)).only(:_id, :analysis_id, :analysis_type, :status, :status_message, :updated_at, :end_time)

      rows = jobs.map do |job|
        status = job.status.to_s
        status_message = job.respond_to?(:status_message) ? job.status_message.to_s : %q()
        analysis_id = job.analysis_id.to_s
        analysis_status = analysis_status_map[analysis_id] || %q()
        age_minutes = job.updated_at.nil? ? nil : ((now - job.updated_at) / 60).floor

        recovery_path =
          if status_message == %q(post-processing finished)
            %q(promote_completed)
          elsif status == %q(started)
            if !age_minutes.nil? && age_minutes >= stale
              %q(recover_started)
            else
              %q(monitor_started)
            end
          elsif status == %q(queued)
            if !age_minutes.nil? && age_minutes >= stale
              %q(requeue_or_quarantine)
            else
              %q(monitor_queue)
            end
          else
            %q(manual_review)
          end

        terminal_record = (recovery_path == %q(promote_completed))
        status_bucket =
          if terminal_record
            %q(terminal_but_not_completed)
          elsif status == %q(started) || status == %q(queued)
            %q(actionable)
          else
            %q(manual_review)
          end

        {
          job_id: job.id.to_s,
          analysis_id: analysis_id,
          analysis_status: analysis_status,
          job_status: status,
          job_status_message: status_message,
          age_minutes: age_minutes,
          status_bucket: status_bucket,
          recovery_path: recovery_path,
          terminal_record: terminal_record,
          needs_work: (status_bucket != %q(terminal_but_not_completed))
        }
      end

      puts JSON.pretty_generate(rows)
    '
  " | sed '/MONGODB | Unsupported client option/d' > "$raw_file"

  jq -r '
    map(
      .age_minutes = (.age_minutes // null)
      | .analysis_id = (.analysis_id // "")
      | .analysis_status = (.analysis_status // "")
      | .job_status = (.job_status // "")
      | .job_status_message = (.job_status_message // "")
      | .status_bucket = (.status_bucket // "manual_review")
      | .recovery_path = (.recovery_path // "manual_review")
      | .terminal_record = (.terminal_record // false)
      | .needs_work = (.needs_work // true)
    )
    | sort_by(.status_bucket, .job_status, .analysis_id, .job_id)
  ' "$raw_file" > "$inventory_json"

  jq -r '
    ["job_id","analysis_id","analysis_status","job_status","job_status_message","age_minutes","status_bucket","recovery_path","terminal_record","needs_work"],
    (.[] | [
      .job_id,
      .analysis_id,
      .analysis_status,
      .job_status,
      .job_status_message,
      (.age_minutes | tostring),
      .status_bucket,
      .recovery_path,
      (.terminal_record | tostring),
      (.needs_work | tostring)
    ])
    | @tsv
  ' "$inventory_json" > "$inventory_tsv"
}

read_queue_pipeline_health() {
  local redis_pod depths analyses analysis_wrappers simulations
  redis_pod="$(get_redis_pod)"

  if ! depths="$(
    kubectl -n "$NAMESPACE" exec "$redis_pod" -- sh -lc '
      PW="${REDIS_PASSWORD:-}"
      AUTH=""
      if [ -n "$PW" ]; then AUTH="-a $PW --no-auth-warning"; fi
      for q in analyses analysis_wrappers simulations; do
        printf "%s=" "$q"
        redis-cli $AUTH LLEN "resque:queue:$q"
      done
    ' | tr -d '\r'
  )"; then
    if [[ "$STRICT" == "true" ]]; then
      die "redis queue pipeline read failed"
    fi
    warn "redis queue pipeline read failed"
    return 0
  fi

  analyses="$(grep '^analyses=' <<<"$depths" | sed 's/^analyses=//' || true)"
  analysis_wrappers="$(grep '^analysis_wrappers=' <<<"$depths" | sed 's/^analysis_wrappers=//' || true)"
  simulations="$(grep '^simulations=' <<<"$depths" | sed 's/^simulations=//' || true)"

  if [[ "$analysis_wrappers" =~ ^[0-9]+$ && "$simulations" =~ ^[0-9]+$ ]] && (( analysis_wrappers > 0 && simulations == 0 )); then
    warn "Queue pipeline warning: analysis_wrappers=${analysis_wrappers} while simulations=${simulations}. Workers will not scale until web/web-background enqueue simulation jobs."
  fi

  if [[ "$analyses" =~ ^[0-9]+$ && "$analysis_wrappers" =~ ^[0-9]+$ && "$simulations" =~ ^[0-9]+$ ]] && (( analyses > 0 && analysis_wrappers == 0 && simulations == 0 )); then
    warn "Queue pipeline warning: analyses=${analyses} with analysis_wrappers=${analysis_wrappers} and simulations=${simulations}. web-background may not be consuming analyses."
  fi
}

read_web_auth_signals() {
  local web_logs
  web_logs="$(kubectl -n "$NAMESPACE" logs deploy/web --tail=200 2>/dev/null || true)"
  if grep -Eq "Mongo::Auth::Unauthorized|Authentication failed|UserNotFound" <<<"$web_logs"; then
    warn "Detected Mongo auth failures in recent web logs; analyses may stall before simulation enqueue."
    grep -E "Mongo::Auth::Unauthorized|Authentication failed|UserNotFound" <<<"$web_logs" | tail -n 20
  fi
}

read_node_memory_pressure_state() {
  local node_rows memory_pressure_nodes
  log "Node health and pressure summary"
  node_rows="$(
    kubectl get nodes \
      -o 'custom-columns=NAME:.metadata.name,READY:.status.conditions[?(@.type=="Ready")].status,MEMORY:.status.conditions[?(@.type=="MemoryPressure")].status,DISK:.status.conditions[?(@.type=="DiskPressure")].status,PID:.status.conditions[?(@.type=="PIDPressure")].status' \
      --no-headers 2>/dev/null || true
  )"

  if [[ -z "$node_rows" ]]; then
    warn "Unable to read node pressure state"
    return 0
  fi

  local not_ready_nodes disk_pressure_nodes pid_pressure_nodes
  not_ready_nodes="$(awk '$2 != "True" {c++} END {print c+0}' <<<"$node_rows")"
  disk_pressure_nodes="$(awk '$4 == "True" {c++} END {print c+0}' <<<"$node_rows")"
  pid_pressure_nodes="$(awk '$5 == "True" {c++} END {print c+0}' <<<"$node_rows")"
  memory_pressure_nodes="$(awk '$3 == "True" {c++} END {print c+0}' <<<"$node_rows")"
  if [[ "$not_ready_nodes" =~ ^[0-9]+$ ]] && (( not_ready_nodes > 0 )); then
    warn "NotReady/Unknown detected on ${not_ready_nodes} node(s); keep the worker ceiling unchanged"
  fi
  if [[ "$memory_pressure_nodes" =~ ^[0-9]+$ ]] && (( memory_pressure_nodes > 0 )); then
    warn "MemoryPressure detected on ${memory_pressure_nodes} node(s); keep the worker ceiling at the stable ready count"
  fi
  if [[ "$disk_pressure_nodes" =~ ^[0-9]+$ ]] && (( disk_pressure_nodes > 0 )); then
    warn "DiskPressure detected on ${disk_pressure_nodes} node(s); keep the worker ceiling unchanged"
  fi
  if [[ "$pid_pressure_nodes" =~ ^[0-9]+$ ]] && (( pid_pressure_nodes > 0 )); then
    warn "PIDPressure detected on ${pid_pressure_nodes} node(s); keep the worker ceiling unchanged"
  fi

  echo "$node_rows"
}

count_node_health_blockers() {
  local node_rows not_ready_nodes memory_pressure_nodes disk_pressure_nodes pid_pressure_nodes
  node_rows="$(
    kubectl get nodes \
      -o 'custom-columns=NAME:.metadata.name,READY:.status.conditions[?(@.type=="Ready")].status,MEMORY:.status.conditions[?(@.type=="MemoryPressure")].status,DISK:.status.conditions[?(@.type=="DiskPressure")].status,PID:.status.conditions[?(@.type=="PIDPressure")].status' \
      --no-headers 2>/dev/null || true
  )"

  if [[ -z "$node_rows" ]]; then
    echo 0
    return 0
  fi

  not_ready_nodes="$(awk '$2 != "True" {c++} END {print c+0}' <<<"$node_rows")"
  memory_pressure_nodes="$(awk '$3 == "True" {c++} END {print c+0}' <<<"$node_rows")"
  disk_pressure_nodes="$(awk '$4 == "True" {c++} END {print c+0}' <<<"$node_rows")"
  pid_pressure_nodes="$(awk '$5 == "True" {c++} END {print c+0}' <<<"$node_rows")"

  echo "$(( not_ready_nodes + memory_pressure_nodes + disk_pressure_nodes + pid_pressure_nodes ))"
}

get_calico_node_qos_summary() {
  local pod_json inst_json total non_guaranteed cr_hardened
  pod_json="$(kubectl -n calico-system get pods -l k8s-app=calico-node -o json 2>/dev/null || true)"
  if [[ -z "$pod_json" ]]; then
    echo "total=0"
    echo "non_guaranteed=0"
    echo "cr_hardened=1"
    return 0
  fi

  total="$(jq -r '.items | length' <<<"$pod_json" 2>/dev/null || echo 0)"
  non_guaranteed="$(jq -r '[.items[] | select(.status.qosClass != "Guaranteed")] | length' <<<"$pod_json" 2>/dev/null || echo 0)"
  [[ "$total" =~ ^[0-9]+$ ]] || total=0
  [[ "$non_guaranteed" =~ ^[0-9]+$ ]] || non_guaranteed=0

  # cr_hardened tracks whether the tigera-operator Installation CR still carries the
  # calico-node/install-cni/flexvol-driver resource requests that give calico-node
  # Guaranteed QoS (see openstack/TROUBLESHOOTING.md calico-node OOM incident). A helm
  # upgrade of the cni-calico release, or an Azimuth-side addon reconcile, can silently
  # drop this override since it lives only as live Installation CR state.
  cr_hardened=1
  if (( total > 0 )); then
    if inst_json="$(kubectl get installation default -o json 2>/dev/null)" && [[ -n "$inst_json" ]]; then
      cr_hardened="$(jq -r '
        def has_req($c): (($c.resources.requests.cpu // "") != "") and (($c.resources.requests.memory // "") != "");
        ( [.spec.calicoNodeDaemonSet.spec.template.spec.containers[]? | select(.name=="calico-node") | has_req(.)] | any ) as $main
        | ( [.spec.calicoNodeDaemonSet.spec.template.spec.initContainers[]? | select(.name=="install-cni") | has_req(.)] | any ) as $cni
        | ( [.spec.calicoNodeDaemonSet.spec.template.spec.initContainers[]? | select(.name=="flexvol-driver") | has_req(.)] | any ) as $flexvol
        | if ($main and $cni and $flexvol) then 1 else 0 end
      ' <<<"$inst_json" 2>/dev/null || echo 0)"
      [[ "$cr_hardened" =~ ^[0-1]$ ]] || cr_hardened=0
    else
      cr_hardened=0
    fi
  fi

  echo "total=${total}"
  echo "non_guaranteed=${non_guaranteed}"
  echo "cr_hardened=${cr_hardened}"
}

read_calico_node_qos_state() {
  local summary total non_guaranteed cr_hardened
  summary="$(get_calico_node_qos_summary)"
  total="$(extract_count_from_kv "total" "$summary")"
  non_guaranteed="$(extract_count_from_kv "non_guaranteed" "$summary")"
  cr_hardened="$(extract_count_from_kv "cr_hardened" "$summary")"

  log "Calico-node QoS drift summary (Installation CR resource hardening)"
  echo "CALICO_NODE_QOS total=${total} non_guaranteed=${non_guaranteed} cr_hardened=${cr_hardened} non_guaranteed_threshold=${CALICO_QOS_NON_GUARANTEED_THRESHOLD}"
  if (( total == 0 )); then
    log "No calico-node pods found in calico-system; skipping drift check"
    return 0
  fi
  if (( cr_hardened == 0 )); then
    warn "tigera Installation CR 'default' is missing calico-node/install-cni/flexvol-driver resource requests; QoS drift risk (revert to BestEffort possible)"
  fi
  if (( non_guaranteed >= CALICO_QOS_NON_GUARANTEED_THRESHOLD )); then
    warn "calico-node pods below Guaranteed QoS: ${non_guaranteed} (threshold=${CALICO_QOS_NON_GUARANTEED_THRESHOLD}); keep the worker ceiling unchanged"
  fi
}

get_problem_pod_counts() {
  local stale_seconds
  stale_seconds="$((STALE_TERMINATING_MINUTES * 60))"
  kubectl -n "$NAMESPACE" get pods -o json 2>/dev/null | jq -r --argjson stale_seconds "$stale_seconds" '
    reduce .items[] as $pod (
      {
        pending: 0,
        init: 0,
        crash: 0,
        pull: 0,
        create: 0,
        stale_terminating: 0,
        total: 0
      };
      (
        [$pod.status.initContainerStatuses[]?.state.waiting.reason?, $pod.status.containerStatuses[]?.state.waiting.reason?]
        | map(select(. != null))
      ) as $reasons
      | ($pod.status.phase // "") as $phase
      | ($pod.metadata.deletionTimestamp // "") as $deletion_ts
      | (if ($deletion_ts | length) > 0 then (now - ($deletion_ts | fromdateiso8601? // 0)) else 0 end) as $terminating_age
      | (if $phase == "Pending" then .pending += 1 else . end)
      | (if ($reasons | map(test("^Init:")) | any) then .init += 1 else . end)
      | (if ($reasons | index("CrashLoopBackOff")) then .crash += 1 else . end)
      | (if (($reasons | index("ImagePullBackOff")) or ($reasons | index("ErrImagePull"))) then .pull += 1 else . end)
      | (if (($reasons | index("ContainerCreating")) or ($reasons | index("PodInitializing")) or ($reasons | index("CreateContainerError")) or ($reasons | index("CreateContainerConfigError"))) then .create += 1 else . end)
      | (
          if (($deletion_ts | length) > 0) and ($terminating_age >= $stale_seconds)
          then .stale_terminating += 1
          else .
          end
        )
      | (
          if (
            ($phase == "Pending")
            or ($reasons | map(test("^Init:")) | any)
            or ($reasons | index("CrashLoopBackOff"))
            or ($reasons | index("ImagePullBackOff"))
            or ($reasons | index("ErrImagePull"))
            or ($reasons | index("ContainerCreating"))
            or ($reasons | index("PodInitializing"))
            or ($reasons | index("CreateContainerError"))
            or ($reasons | index("CreateContainerConfigError"))
            or ((($deletion_ts | length) > 0) and ($terminating_age >= $stale_seconds))
          )
          then .total += 1
          else .
          end
        )
    )
    | "pending=\(.pending)\ninit=\(.init)\ncrash=\(.crash)\npull=\(.pull)\ncreate=\(.create)\nstale_terminating=\(.stale_terminating)\ntotal=\(.total)"
  ' || true
}

count_problem_pods() {
  local pod_counts pod_total
  pod_counts="$(get_problem_pod_counts)"
  pod_total="$(grep '^total=' <<<"$pod_counts" | sed 's/^total=//' || true)"
  if [[ "$pod_total" =~ ^[0-9]+$ ]]; then
    echo "$pod_total"
  else
    echo 0
  fi
}

cleanup_failed_worker_pod_artifacts() {
  local pod_json total
  local -a delete_pods
  [[ "$APPLY" == "true" ]] || die "--cleanup-failed-worker-pods requires --apply"
  [[ "$CLEANUP_MAX_DELETE" =~ ^[0-9]+$ ]] || die "--cleanup-max-delete must be an integer"
  (( CLEANUP_MAX_DELETE >= 1 )) || die "--cleanup-max-delete must be >= 1"

  pod_json="$(kubectl -n "$NAMESPACE" get pods -l "app=worker,release=${RELEASE}" -o json 2>/dev/null || true)"
  if [[ -z "$pod_json" ]]; then
    warn "Could not read worker pods for cleanup"
    return 0
  fi

  mapfile -t delete_pods < <(
    jq -r '
      .items[]
      | select((.status.phase == "Failed") or (.status.reason == "Evicted"))
      | .metadata.name
    ' <<<"$pod_json" | head -n "$CLEANUP_MAX_DELETE"
  )

  total="$(
    jq '
      [.items[]
       | select((.status.phase == "Failed") or (.status.reason == "Evicted"))
      ] | length
    ' <<<"$pod_json"
  )"
  [[ "$total" =~ ^[0-9]+$ ]] || total=0

  if (( total == 0 )); then
    log "Worker artifact cleanup: no failed/evicted worker pods found"
    return 0
  fi

  log "Worker artifact cleanup: deleting ${#delete_pods[@]} failed/evicted worker pod(s) (total candidates=${total})"
  kubectl -n "$NAMESPACE" delete pod "${delete_pods[@]}" --wait=false --ignore-not-found >/dev/null
}

cleanup_stale_terminating_worker_pods() {
  local stale_seconds pod_json total
  local -a delete_pods
  [[ "$APPLY" == "true" ]] || die "--cleanup-stale-terminating-worker-pods requires --apply"
  [[ "$CLEANUP_STALE_MAX_DELETE" =~ ^[0-9]+$ ]] || die "--cleanup-stale-max-delete must be an integer"
  (( CLEANUP_STALE_MAX_DELETE >= 1 )) || die "--cleanup-stale-max-delete must be >= 1"
  stale_seconds="$((STALE_TERMINATING_MINUTES * 60))"

  pod_json="$(kubectl -n "$NAMESPACE" get pods -l "app=worker,release=${RELEASE}" -o json 2>/dev/null || true)"
  if [[ -z "$pod_json" ]]; then
    warn "Could not read worker pods for stale-terminating cleanup"
    return 0
  fi

  mapfile -t delete_pods < <(
    jq -r --argjson stale_seconds "$stale_seconds" '
      .items[]
      | select(.metadata.deletionTimestamp != null)
      | ((now - (.metadata.deletionTimestamp | fromdateiso8601? // 0)) // 0) as $age
      | select($age >= $stale_seconds)
      | .metadata.name
    ' <<<"$pod_json" | head -n "$CLEANUP_STALE_MAX_DELETE"
  )

  total="$(
    jq -r --argjson stale_seconds "$stale_seconds" '
      [.items[]
      | select(.metadata.deletionTimestamp != null)
      | ((now - (.metadata.deletionTimestamp | fromdateiso8601? // 0)) // 0) as $age
      | select($age >= $stale_seconds)
      ] | length
    ' <<<"$pod_json"
  )"
  [[ "$total" =~ ^[0-9]+$ ]] || total=0

  if (( total == 0 )); then
    log "Stale terminating cleanup: no worker pods exceeded ${STALE_TERMINATING_MINUTES}m"
    return 0
  fi

  log "Stale terminating cleanup: deleting ${#delete_pods[@]} worker pod(s) (total candidates=${total}, stale>${STALE_TERMINATING_MINUTES}m)"
  kubectl -n "$NAMESPACE" delete pod "${delete_pods[@]}" --wait=false --ignore-not-found >/dev/null
}

