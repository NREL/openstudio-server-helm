RELEASE="openstudio-server"
CHART_DIR="./openstudio-server"
MODE="check"
APPLY=false
SNAPSHOT_DIR=""
STRICT=true
ALLOW_CHART_APPLY=false
ALLOW_NON_CONFLICT_RECONCILE=false
STALE_THRESHOLD_MINUTES=70
RECOVERY_LOCK_TTL_SECONDS=1800
RECOVERY_LOCK_KEY=""
BASELINE_DURATION_SECONDS=1200
BASELINE_INTERVAL_SECONDS=30
QUIET_WINDOW_SECONDS=900
QUIET_WINDOW_INTERVAL_SECONDS=30
PROBE_STEP_REPLICAS=50
PROBE_MAX_REPLICAS_LIMIT="1200"
EVENT_WINDOW_SECONDS=900
EVENT_HARD_BLOCKER_THRESHOLD=3
EVENT_SOFT_BLOCKER_THRESHOLD=5
PROBLEM_POD_BLOCKER_THRESHOLD=3
CALICO_QOS_NON_GUARANTEED_THRESHOLD=3
STALE_TERMINATING_MINUTES=10
WORKER_READINESS_MIN_RATIO_PERCENT=50
CLEANUP_FAILED_WORKER_PODS=false
CLEANUP_MAX_DELETE=200
CLEANUP_STALE_TERMINATING_WORKER_PODS=false
CLEANUP_STALE_MAX_DELETE=100
PROBE_DIAGNOSTICS=false
SNAPSHOT_ON_BLOCK=false
PERSISTENT_BLOCKER_SNAPSHOT_THRESHOLD=2
ANALYSIS_ID=""
FAILED_QUEUE_TRIAGE_SAMPLE_LIMIT=500

LAST_BLOCKER_REASON_CODES=""
LAST_NODE_BLOCKERS=0
LAST_PROBLEM_PODS=0
LAST_STALE_TERMINATING_PODS=0
LAST_HARD_EVENT_COUNT=0
LAST_SOFT_EVENT_COUNT=0
