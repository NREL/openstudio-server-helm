read_keda_state() {
  if kubectl -n "$NAMESPACE" get scaledobject worker >/dev/null 2>&1; then
    log "KEDA state for worker autoscaling"
    kube_probe "worker scaledobject read" kubectl -n "$NAMESPACE" get scaledobject worker -o wide
    kube_probe "worker triggerauthentication read" kubectl -n "$NAMESPACE" get triggerauthentication worker-keda-redis-auth -o wide
    kube_probe "keda operator pod read" bash -lc "kubectl get pods -A | grep -E 'keda-operator|keda-admission-webhooks'"
  else
    log "No worker ScaledObject detected; skipping KEDA-specific checks"
  fi
}

read_app_job_counts() {
  local web_pod
  web_pod="$(get_web_pod)"

  log "Job status counts from pod ${web_pod}"
  kube_probe "rails job counts read" kubectl -n "$NAMESPACE" exec "$web_pod" -- bash -lc '
    cd /opt/openstudio/server
    bundle exec rails runner "puts %(queued=#{Job.where(status: \"queued\").count} started=#{Job.where(status: \"started\").count} running=#{Job.where(status: \"running\").count} completed=#{Job.where(status: \"completed\").count} failed=#{Job.where(status: \"failed\").count} na=#{Job.where(status: \"na\").count})"
  '
}

read_divergence_signals() {
  local web_pod
  web_pod="$(get_web_pod)"

  log "Divergence signals (stale > ${STALE_THRESHOLD_MINUTES}m) from pod ${web_pod}"
  kube_probe "rails divergence read" kubectl -n "$NAMESPACE" exec "$web_pod" -- bash -lc "
    cd /opt/openstudio/server
    STALE_MINUTES='${STALE_THRESHOLD_MINUTES}' bundle exec rails runner '
      stale = ENV.fetch(%q(STALE_MINUTES), %q(70)).to_i
      cutoff = Time.now - stale.minutes
      stale_jobs = Job.where(status: %q(started), :updated_at.lt => cutoff).count
      started_analysis_ids = Analysis.all.select { |a| a.status == %q(started) }.map(&:id)
      stale_dp_active = DataPoint.where(:analysis_id.in => started_analysis_ids, status: %q(started), :updated_at.lt => cutoff).count
      stale_dp_orphan = DataPoint.where(status: %q(started), :updated_at.lt => cutoff, :analysis_id.nin => started_analysis_ids).count
      stale_na_dp_active = DataPoint.where(:analysis_id.in => started_analysis_ids, status: %q(na), :updated_at.lt => cutoff).count
      stale_na_dp_orphan = DataPoint.where(status: %q(na), :updated_at.lt => cutoff, :analysis_id.nin => started_analysis_ids).count
      stale_started_analyses = Job.where(status: %q(started), :updated_at.lt => cutoff).pluck(:analysis_id).uniq.count
      started_analyses = started_analysis_ids.count
      puts %(stale_started_jobs=#{stale_jobs} stale_started_datapoints_active=#{stale_dp_active} stale_started_datapoints_orphan=#{stale_dp_orphan} stale_na_datapoints_active=#{stale_na_dp_active} stale_na_datapoints_orphan=#{stale_na_dp_orphan} stale_started_analyses=#{stale_started_analyses} started_analyses=#{started_analyses})
    '
  "
}

read_analysis_focus() {
  local web_pod
  [[ -n "${ANALYSIS_ID}" ]] || return 0
  web_pod="$(get_web_pod)"
  log "Focused lifecycle diagnostics for analysis ${ANALYSIS_ID} (stale > ${STALE_THRESHOLD_MINUTES}m)"
  kube_probe "rails focused analysis read" kubectl -n "$NAMESPACE" exec "$web_pod" -- bash -lc "
    cd /opt/openstudio/server
    ANALYSIS_ID='${ANALYSIS_ID}' STALE_MINUTES='${STALE_THRESHOLD_MINUTES}' bundle exec rails runner '
      aid = ENV.fetch(%q(ANALYSIS_ID))
      stale = ENV.fetch(%q(STALE_MINUTES), %q(70)).to_i
      cutoff = Time.now - stale.minutes
      analysis = Analysis.where(id: aid).first
      if analysis.nil?
        puts %(analysis_focus analysis_id=#{aid} found=false)
        exit 0
      end
      job_status = Job.where(analysis_id: aid).group_by(&:status).transform_values(&:count)
      dp_status = DataPoint.where(analysis_id: aid).group_by(&:status).transform_values(&:count)
      stale_started = DataPoint.where(analysis_id: aid, status: %q(started), :updated_at.lt => cutoff).count
      stale_na = DataPoint.where(analysis_id: aid, status: %q(na), :updated_at.lt => cutoff).count
      puts %(analysis_focus analysis_id=#{aid} found=true analysis_status=#{analysis.status} stale_started_datapoints=#{stale_started} stale_na_datapoints=#{stale_na} jobs_total=#{Job.where(analysis_id: aid).count} datapoints_total=#{DataPoint.where(analysis_id: aid).count})
      job_pairs = job_status.sort_by { |k,_| k.to_s }.map { |k,v| %Q(#{k || %q(nil)}=#{v}) }
      dp_pairs = dp_status.sort_by { |k,_| k.to_s }.map { |k,v| %Q(#{k || %q(nil)}=#{v}) }
      puts %(analysis_focus_job_status #{job_pairs.join(%q( ))})
      puts %(analysis_focus_datapoint_status #{dp_pairs.join(%q( ))})
    '
  "
}

read_recent_warning_event_signals() {
  local events
  log "Recent warning-event signals"
  events="$(get_recent_warning_events)"

  if [[ -z "$events" ]]; then
    warn "No recent warning events returned"
    return 0
  fi

  local patterns=(
    "NodeNotReady"
    "NetworkNotReady"
    "FailedCreatePodSandBox"
    "failed to sync secret cache"
    "SystemOOM"
    "ImagePullBackOff"
    "ErrImagePull"
    "503 Service Unavailable"
    "SyncLoadBalancerFailed"
  )

  local pattern count
  for pattern in "${patterns[@]}"; do
    count="$(grep -ciF "$pattern" <<<"$events" || true)"
    if [[ "$count" =~ ^[0-9]+$ ]] && (( count > 0 )); then
      warn "Recent warning events matching '${pattern}': ${count}"
    fi
  done

  echo "$events" | tail -20
}

read_platform_blocker_summary() {
  local events class_counts sandbox_count image_count pull_secret_count metric_count worker_readiness
  local desired ready available ratio_percent worker_blocker reason_codes
  events="$(get_recent_warning_events)"
  class_counts="$(get_platform_warning_event_counts "$events")"
  sandbox_count="$(extract_count_from_kv "pod_sandbox_network" "$class_counts")"
  image_count="$(extract_count_from_kv "image_pull_auth" "$class_counts")"
  pull_secret_count="$(extract_count_from_kv "failed_pull_secret" "$class_counts")"
  metric_count="$(extract_count_from_kv "external_metric" "$class_counts")"

  worker_readiness="$(get_worker_readiness_snapshot)"
  desired="$(extract_count_from_kv "desired" "$worker_readiness")"
  ready="$(extract_count_from_kv "ready" "$worker_readiness")"
  available="$(extract_count_from_kv "available" "$worker_readiness")"
  ratio_percent="$(extract_count_from_kv "ratio_percent" "$worker_readiness")"
  worker_blocker="$(extract_count_from_kv "blocker" "$worker_readiness")"

  reason_codes=""
  if (( sandbox_count >= EVENT_HARD_BLOCKER_THRESHOLD )); then
    reason_codes="$(merge_queue_csv "$reason_codes" "platform_pod_sandbox_network_blocked")"
  fi
  if (( image_count >= EVENT_SOFT_BLOCKER_THRESHOLD )); then
    reason_codes="$(merge_queue_csv "$reason_codes" "platform_image_pull_auth_blocked")"
  fi
  if (( metric_count >= EVENT_SOFT_BLOCKER_THRESHOLD )); then
    reason_codes="$(merge_queue_csv "$reason_codes" "platform_external_metrics_blocked")"
  fi
  if (( worker_blocker > 0 )); then
    reason_codes="$(merge_queue_csv "$reason_codes" "worker_readiness_blocked")"
  fi
  reason_codes="$(normalize_hold_reason_codes "$reason_codes")"

  log "Platform blocker classes (event window=${EVENT_WINDOW_SECONDS}s)"
  echo "PLATFORM_BLOCKER_COUNTS pod_sandbox_network=${sandbox_count} image_pull_auth=${image_count} failed_pull_secret=${pull_secret_count} external_metric=${metric_count}"
  echo "PLATFORM_BLOCKER_THRESHOLDS pod_sandbox_network=${EVENT_HARD_BLOCKER_THRESHOLD} image_pull_auth=${EVENT_SOFT_BLOCKER_THRESHOLD} external_metric=${EVENT_SOFT_BLOCKER_THRESHOLD}"
  echo "WORKER_READINESS desired=${desired} ready=${ready} available=${available} ratio_percent=${ratio_percent} min_ratio_percent=${WORKER_READINESS_MIN_RATIO_PERCENT}"
  echo "PLATFORM_BLOCKER_REASON_CODES=${reason_codes:-none}"
  print_hold_reason_mapping "$reason_codes"
}

read_loadbalancer_event_signals() {
  local service_events sync_failures octavia_503
  log "Ingress load balancer event signals"
  service_events="$(
    kubectl -n "$NAMESPACE" get events \
      --field-selector involvedObject.kind=Service,involvedObject.name=ingress-load-balancer \
      --sort-by=.lastTimestamp \
      -o custom-columns=LAST:.lastTimestamp,REASON:.reason,MSG:.message \
      2>/dev/null | tail -100 || true
  )"

  if [[ -z "$service_events" ]]; then
    warn "No ingress-load-balancer service events returned"
    return 0
  fi

  sync_failures="$(grep -ciE 'SyncLoadBalancerFailed|UpdateLoadBalancerFailed' <<<"$service_events" || true)"
  octavia_503="$(grep -ciF '503 Service Unavailable' <<<"$service_events" || true)"

  if [[ "$sync_failures" =~ ^[0-9]+$ ]] && (( sync_failures > 0 )); then
    warn "Ingress load balancer sync failures observed: ${sync_failures}"
  fi
  if [[ "$octavia_503" =~ ^[0-9]+$ ]] && (( octavia_503 > 0 )); then
    warn "Ingress load balancer Octavia 503 events observed: ${octavia_503}"
  fi
  if [[ "$sync_failures" =~ ^[0-9]+$ ]] && (( sync_failures >= 3 )); then
    warn "Ingress load balancer failures look sustained; escalate to the platform team if they continue"
  fi

  echo "$service_events" | tail -20
}

get_recent_warning_events() {
  local now_epoch start_epoch
  now_epoch="$(date +%s)"
  start_epoch="$((now_epoch - EVENT_WINDOW_SECONDS))"
  kubectl -n "$NAMESPACE" get events -o json 2>/dev/null \
    | jq -r --argjson start_epoch "$start_epoch" '
      .items[]
      | {
          ts: (.eventTime // .series.lastObservedTime // .lastTimestamp // .metadata.creationTimestamp // ""),
          kind: (.involvedObject.kind // ""),
          name: (.involvedObject.name // ""),
          reason: (.reason // ""),
          msg: (.message // ""),
          type: (.type // "")
        }
      | .epoch = ((.ts | fromdateiso8601?) // 0)
      | select(.type == "Warning" and .epoch >= $start_epoch)
      | "\(.ts)\t\(.kind)\t\(.name)\t\(.reason)\t\(.msg)"
    ' || true
}

extract_count_from_kv() {
  local key=$1
  local text=$2
  local value
  value="$(grep "^${key}=" <<<"$text" | head -n1 | sed "s/^${key}=//" || true)"
  if [[ "$value" =~ ^[0-9]+$ ]]; then
    echo "$value"
  else
    echo 0
  fi
}

get_platform_warning_event_counts() {
  local events="$1"
  local pod_sandbox_network image_pull_auth failed_pull_secret external_metric

  if [[ -z "$events" ]]; then
    echo "pod_sandbox_network=0"
    echo "image_pull_auth=0"
    echo "failed_pull_secret=0"
    echo "external_metric=0"
    return 0
  fi

  pod_sandbox_network="$(grep -ciE 'FailedCreatePodSandBox|NetworkNotReady|failed to create pod sandbox|failed to setup network|calico' <<<"$events" || true)"
  image_pull_auth="$(grep -ciE 'ImagePullBackOff|ErrImagePull|FailedToRetrieveImagePullSecret|failed to pull image|Back-off pulling image|pull access denied|UNAUTHORIZED|unauthorized' <<<"$events" || true)"
  failed_pull_secret="$(grep -ciE 'FailedToRetrieveImagePullSecret' <<<"$events" || true)"
  external_metric="$(grep -ciE 'FailedGetExternalMetric|failed to get external metric|error getting external metric|unable to get external metric|KEDAScalerFailed|keda.*metric' <<<"$events" || true)"

  [[ "$pod_sandbox_network" =~ ^[0-9]+$ ]] || pod_sandbox_network=0
  [[ "$image_pull_auth" =~ ^[0-9]+$ ]] || image_pull_auth=0
  [[ "$failed_pull_secret" =~ ^[0-9]+$ ]] || failed_pull_secret=0
  [[ "$external_metric" =~ ^[0-9]+$ ]] || external_metric=0

  echo "pod_sandbox_network=${pod_sandbox_network}"
  echo "image_pull_auth=${image_pull_auth}"
  echo "failed_pull_secret=${failed_pull_secret}"
  echo "external_metric=${external_metric}"
}

get_worker_readiness_snapshot() {
  local deploy_json desired ready available ratio_percent blocker
  deploy_json="$(kubectl -n "$NAMESPACE" get deploy worker -o json 2>/dev/null || true)"
  if [[ -z "$deploy_json" ]]; then
    echo "desired=0"
    echo "ready=0"
    echo "available=0"
    echo "ratio_percent=0"
    echo "blocker=1"
    return 0
  fi

  desired="$(jq -r '.spec.replicas // 0' <<<"$deploy_json" 2>/dev/null || echo 0)"
  ready="$(jq -r '.status.readyReplicas // 0' <<<"$deploy_json" 2>/dev/null || echo 0)"
  available="$(jq -r '.status.availableReplicas // 0' <<<"$deploy_json" 2>/dev/null || echo 0)"
  [[ "$desired" =~ ^[0-9]+$ ]] || desired=0
  [[ "$ready" =~ ^[0-9]+$ ]] || ready=0
  [[ "$available" =~ ^[0-9]+$ ]] || available=0

  if (( desired > 0 )); then
    ratio_percent=$(( (available * 100) / desired ))
  else
    ratio_percent=100
  fi

  blocker=0
  if (( desired > 0 )) && (( ready < 1 || available < 1 || ratio_percent < WORKER_READINESS_MIN_RATIO_PERCENT )); then
    blocker=1
  fi

  echo "desired=${desired}"
  echo "ready=${ready}"
  echo "available=${available}"
  echo "ratio_percent=${ratio_percent}"
  echo "blocker=${blocker}"
}

count_queue_pipeline_blockers() {
  local redis_pod depths analyses analysis_wrappers simulations blockers
  redis_pod="$(get_redis_pod)"
  blockers=0

  if ! depths="$(
    kubectl -n "$NAMESPACE" exec "$redis_pod" -- sh -lc '
      PW="${REDIS_PASSWORD:-}"
      AUTH=""
      if [ -n "$PW" ]; then AUTH="-a $PW --no-auth-warning"; fi
      for q in analyses analysis_wrappers simulations; do
        printf "%s=" "$q"
        redis-cli $AUTH LLEN "resque:queue:$q"
      done
    ' | tr -d '\r'
  )"; then
    warn "Queue pipeline blocker: unable to read redis queue depths"
    echo 1
    return 0
  fi

  analyses="$(grep '^analyses=' <<<"$depths" | sed 's/^analyses=//' || true)"
  analysis_wrappers="$(grep '^analysis_wrappers=' <<<"$depths" | sed 's/^analysis_wrappers=//' || true)"
  simulations="$(grep '^simulations=' <<<"$depths" | sed 's/^simulations=//' || true)"

  if [[ "$analysis_wrappers" =~ ^[0-9]+$ && "$simulations" =~ ^[0-9]+$ ]] && (( analysis_wrappers > 0 && simulations == 0 )); then
    warn "Queue pipeline blocker: analysis_wrappers=${analysis_wrappers} while simulations=${simulations}"
    blockers=$((blockers + 1))
  fi

  if [[ "$analyses" =~ ^[0-9]+$ && "$analysis_wrappers" =~ ^[0-9]+$ && "$simulations" =~ ^[0-9]+$ ]] && (( analyses > 0 && analysis_wrappers == 0 && simulations == 0 )); then
    warn "Queue pipeline blocker: analyses=${analyses} while analysis_wrappers=${analysis_wrappers} and simulations=${simulations}"
    blockers=$((blockers + 1))
  fi

  echo "$blockers"
}

count_core_service_readiness_blockers() {
  local app blockers ready_count
  blockers=0
  for app in web web-background redis rserve; do
    # The status.phase field selector is not supported by all API servers; filter via jq.
    ready_count="$(
      kubectl -n "$NAMESPACE" get pods \
        -l "app=${app},release=${RELEASE}" \
        -o json 2>/dev/null \
      | jq '[.items[] | select(.status.phase == "Running") | .status.conditions[]? | select(.type == "Ready" and .status == "True")] | length' \
      || echo 0
    )"
    if ! [[ "$ready_count" =~ ^[0-9]+$ ]] || (( ready_count == 0 )); then
      warn "Core service blocker: no Ready Running pod found for app=${app}"
      blockers=$((blockers + 1))
    fi
  done
  echo "$blockers"
}

get_worker_hpa_spec_max_replicas() {
  local worker_hpa
  worker_hpa="$(get_worker_hpa_name)"
  kubectl -n "$NAMESPACE" get hpa "$worker_hpa" -o jsonpath='{.spec.maxReplicas}'
}

check_scale_up_blockers() {
  local events blocker_patterns warning_patterns pattern count blockers node_blockers
  local pod_counts pod_blockers stale_terminating_pods
  local hard_event_total soft_event_total oom_event_total liveness_event_total
  local platform_counts platform_pod_sandbox_network platform_image_pull_auth platform_external_metric
  local calico_qos_summary calico_qos_total calico_qos_non_guaranteed calico_qos_cr_hardened
  local event_window_end event_window_start reason_codes

  event_window_end="$(date +%s)"
  event_window_start="$((event_window_end - EVENT_WINDOW_SECONDS))"
  LAST_EVENT_WINDOW_START_EPOCH="$event_window_start"
  LAST_EVENT_WINDOW_END_EPOCH="$event_window_end"
  LAST_EVENT_WINDOW_START_ISO="$(jq -nr --argjson ts "$event_window_start" '$ts | todateiso8601')"
  LAST_EVENT_WINDOW_END_ISO="$(jq -nr --argjson ts "$event_window_end" '$ts | todateiso8601')"

  events="$(get_recent_warning_events)"
  blocker_patterns=(
    "FailedCreatePodSandBox"
    "failed to sync secret cache"
    "SystemOOM"
    "OOMKilled"
    "OOMKilling"
    "failed liveness probe"
    "liveness probe failed"
  )
  warning_patterns=(
    "NodeNotReady"
    "NetworkNotReady"
    "ImagePullBackOff"
    "ErrImagePull"
    "503 Service Unavailable"
    "SyncLoadBalancerFailed"
  )

  blockers=0
  reason_codes=""
  hard_event_total=0
  soft_event_total=0
  oom_event_total=0
  liveness_event_total=0

  node_blockers="$(count_node_health_blockers)"
  [[ "$node_blockers" =~ ^[0-9]+$ ]] || node_blockers=0

  pod_counts="$(get_problem_pod_counts)"
  pod_blockers="$(grep '^total=' <<<"$pod_counts" | sed 's/^total=//' || true)"
  stale_terminating_pods="$(grep '^stale_terminating=' <<<"$pod_counts" | sed 's/^stale_terminating=//' || true)"
  [[ "$pod_blockers" =~ ^[0-9]+$ ]] || pod_blockers=0
  [[ "$stale_terminating_pods" =~ ^[0-9]+$ ]] || stale_terminating_pods=0

  if (( node_blockers > 0 )); then
    warn "Node health blockers detected: ${node_blockers}; pausing scale-up"
    blockers=$((blockers + node_blockers))
    reason_codes="$(merge_queue_csv "$reason_codes" "node_health_blocked")"
  fi

  calico_qos_summary="$(get_calico_node_qos_summary)"
  calico_qos_total="$(extract_count_from_kv "total" "$calico_qos_summary")"
  calico_qos_non_guaranteed="$(extract_count_from_kv "non_guaranteed" "$calico_qos_summary")"
  calico_qos_cr_hardened="$(extract_count_from_kv "cr_hardened" "$calico_qos_summary")"

  if (( calico_qos_total > 0 )); then
    if (( calico_qos_cr_hardened == 0 )); then
      warn "tigera Installation CR 'default' is missing calico-node QoS resource hardening; drift risk, pausing scale-up"
      blockers=$((blockers + 1))
      reason_codes="$(merge_queue_csv "$reason_codes" "calico_qos_drift_detected")"
    fi
    if (( calico_qos_non_guaranteed >= CALICO_QOS_NON_GUARANTEED_THRESHOLD )); then
      warn "calico-node pods below Guaranteed QoS: ${calico_qos_non_guaranteed} (threshold=${CALICO_QOS_NON_GUARANTEED_THRESHOLD}); pausing scale-up"
      blockers=$((blockers + calico_qos_non_guaranteed))
      reason_codes="$(merge_queue_csv "$reason_codes" "calico_qos_drift_detected")"
    fi
  fi

  if (( pod_blockers >= PROBLEM_POD_BLOCKER_THRESHOLD )); then
    warn "Problem pods in ${NAMESPACE}: ${pod_blockers} (threshold=${PROBLEM_POD_BLOCKER_THRESHOLD}); pausing scale-up"
    blockers=$((blockers + pod_blockers))
    reason_codes="$(merge_queue_csv "$reason_codes" "problem_pods_high")"
  fi

  if (( stale_terminating_pods >= PROBLEM_POD_BLOCKER_THRESHOLD )); then
    warn "Stale terminating pods in ${NAMESPACE}: ${stale_terminating_pods} (stale>${STALE_TERMINATING_MINUTES}m)"
    reason_codes="$(merge_queue_csv "$reason_codes" "stale_terminating_high")"
  fi

  if [[ -n "$events" ]]; then
    oom_event_total="$(grep -ciE 'SystemOOM|OOMKilled|OOMKilling' <<<"$events" || true)"
    liveness_event_total="$(grep -ciE 'failed liveness probe|liveness probe failed' <<<"$events" || true)"
    [[ "$oom_event_total" =~ ^[0-9]+$ ]] || oom_event_total=0
    [[ "$liveness_event_total" =~ ^[0-9]+$ ]] || liveness_event_total=0

    for pattern in "${blocker_patterns[@]}"; do
      count="$(grep -ciF "$pattern" <<<"$events" || true)"
      if [[ "$count" =~ ^[0-9]+$ ]] && (( count > 0 )); then
        hard_event_total=$((hard_event_total + count))
        warn "Recent warning events matching '${pattern}': ${count}"
      fi
    done

    for pattern in "${warning_patterns[@]}"; do
      count="$(grep -ciF "$pattern" <<<"$events" || true)"
      if [[ "$count" =~ ^[0-9]+$ ]] && (( count > 0 )); then
        soft_event_total=$((soft_event_total + count))
        warn "Recent warning events matching '${pattern}': ${count}"
      fi
    done

    platform_counts="$(get_platform_warning_event_counts "$events")"
    platform_pod_sandbox_network="$(extract_count_from_kv "pod_sandbox_network" "$platform_counts")"
    platform_image_pull_auth="$(extract_count_from_kv "image_pull_auth" "$platform_counts")"
    platform_external_metric="$(extract_count_from_kv "external_metric" "$platform_counts")"
  else
    platform_pod_sandbox_network=0
    platform_image_pull_auth=0
    platform_external_metric=0
  fi

  if (( hard_event_total >= EVENT_HARD_BLOCKER_THRESHOLD )); then
    blockers=$((blockers + hard_event_total))
    reason_codes="$(merge_queue_csv "$reason_codes" "hard_warning_events_high")"
  fi
  if (( soft_event_total >= EVENT_SOFT_BLOCKER_THRESHOLD )); then
    blockers=$((blockers + soft_event_total))
    reason_codes="$(merge_queue_csv "$reason_codes" "soft_warning_events_high")"
  fi
  if (( platform_pod_sandbox_network >= EVENT_HARD_BLOCKER_THRESHOLD )); then
    blockers=$((blockers + platform_pod_sandbox_network))
    reason_codes="$(merge_queue_csv "$reason_codes" "platform_pod_sandbox_network_blocked")"
  fi
  if (( platform_image_pull_auth >= EVENT_SOFT_BLOCKER_THRESHOLD )); then
    blockers=$((blockers + platform_image_pull_auth))
    reason_codes="$(merge_queue_csv "$reason_codes" "platform_image_pull_auth_blocked")"
  fi
  if (( platform_external_metric >= EVENT_SOFT_BLOCKER_THRESHOLD )); then
    blockers=$((blockers + platform_external_metric))
    reason_codes="$(merge_queue_csv "$reason_codes" "platform_external_metrics_blocked")"
  fi
  if (( oom_event_total >= EVENT_HARD_BLOCKER_THRESHOLD )); then
    reason_codes="$(merge_queue_csv "$reason_codes" "oom_rate_high")"
  fi
  if (( liveness_event_total >= EVENT_HARD_BLOCKER_THRESHOLD )); then
    reason_codes="$(merge_queue_csv "$reason_codes" "liveness_failures_high")"
  fi

  LAST_NODE_BLOCKERS="$node_blockers"
  LAST_PROBLEM_PODS="$pod_blockers"
  LAST_STALE_TERMINATING_PODS="$stale_terminating_pods"
  LAST_HARD_EVENT_COUNT="$hard_event_total"
  LAST_SOFT_EVENT_COUNT="$soft_event_total"
  LAST_PLATFORM_POD_SANDBOX_NETWORK_COUNT="$platform_pod_sandbox_network"
  LAST_PLATFORM_IMAGE_PULL_AUTH_COUNT="$platform_image_pull_auth"
  LAST_PLATFORM_EXTERNAL_METRIC_COUNT="$platform_external_metric"
  LAST_CALICO_QOS_NON_GUARANTEED="$calico_qos_non_guaranteed"
  LAST_CALICO_QOS_CR_HARDENED="$calico_qos_cr_hardened"
  LAST_BLOCKER_REASON_CODES="$(normalize_hold_reason_codes "$reason_codes")"

  (( blockers == 0 ))
}

merge_queue_csv() {
  local current="$1"
  local required="$2"
  local merged=""
  local item
  IFS=',' read -ra cur_items <<<"${current}"
  IFS=',' read -ra req_items <<<"${required}"
  for item in "${cur_items[@]}" "${req_items[@]}"; do
    item="$(echo "$item" | xargs)"
    [[ -z "$item" ]] && continue
    if [[ ",${merged}," != *",${item},"* ]]; then
      if [[ -z "$merged" ]]; then
        merged="$item"
      else
        merged="${merged},${item}"
      fi
    fi
  done
  echo "$merged"
}

normalize_hold_reason_codes() {
  local codes="$1"
  local normalized=""
  local code
  local -a ordered=(
    "probe_limit_reached"
    "core_service_readiness_blocked"
    "queue_pipeline_blocked"
    "worker_readiness_blocked"
    "node_health_blocked"
    "calico_qos_drift_detected"
    "problem_pods_high"
    "stale_terminating_high"
    "platform_pod_sandbox_network_blocked"
    "platform_image_pull_auth_blocked"
    "platform_external_metrics_blocked"
    "hard_warning_events_high"
    "soft_warning_events_high"
    "oom_rate_high"
    "liveness_failures_high"
  )
  for code in "${ordered[@]}"; do
    if [[ ",${codes}," == *",${code},"* ]]; then
      normalized="$(merge_queue_csv "$normalized" "$code")"
    fi
  done
  echo "$normalized"
}

hold_reason_description() {
  case "$1" in
    probe_limit_reached) echo "Probe limit reached; maxReplicas already at configured ceiling." ;;
    core_service_readiness_blocked) echo "Core service readiness blocker (web/web-background/redis/rserve not Ready)." ;;
    queue_pipeline_blocked) echo "Queue pipeline blocker in analyses -> analysis_wrappers -> simulations flow." ;;
    worker_readiness_blocked) echo "Worker deployment readiness is below mutation threshold." ;;
    node_health_blocked) echo "Node readiness/pressure blocker detected." ;;
    calico_qos_drift_detected) echo "calico-node QoS hardening reverted or below Guaranteed threshold (Installation CR drift risk)." ;;
    problem_pods_high) echo "Problem pod count reached blocker threshold." ;;
    stale_terminating_high) echo "Stale terminating pod count is elevated." ;;
    platform_pod_sandbox_network_blocked) echo "Sustained pod sandbox/network failure events detected." ;;
    platform_image_pull_auth_blocked) echo "Sustained image pull/auth failure events detected." ;;
    platform_external_metrics_blocked) echo "Sustained external metric retrieval failures detected." ;;
    hard_warning_events_high) echo "Hard warning-event threshold exceeded." ;;
    soft_warning_events_high) echo "Soft warning-event threshold exceeded." ;;
    oom_rate_high) echo "OOM warning-event rate exceeded threshold." ;;
    liveness_failures_high) echo "Liveness failure warning-event rate exceeded threshold." ;;
    *) echo "Unknown hold reason code." ;;
  esac
}

print_hold_reason_mapping() {
  local codes="$1"
  local code
  if [[ -z "$codes" ]]; then
    echo "HOLD_REASON_MAPPING=none"
    return 0
  fi
  IFS=',' read -ra reason_items <<<"$codes"
  for code in "${reason_items[@]}"; do
    [[ -z "$code" ]] && continue
    echo "HOLD_REASON_MAP ${code}=$(hold_reason_description "$code")"
  done
}

ensure_worker_requeue_subscription() {
  local env_lines current_queues merged_queues
  env_lines="$(kubectl -n "$NAMESPACE" get deploy worker -o jsonpath='{range .spec.template.spec.containers[0].env[*]}{.name}={.value}{"\n"}{end}')"
  current_queues="$(grep -E '^QUEUES=' <<<"$env_lines" | sed 's/^QUEUES=//' || true)"
  if [[ -z "$current_queues" ]]; then
    current_queues="$(grep -E '^QUEUE=' <<<"$env_lines" | sed 's/^QUEUE=//' || true)"
  fi
  merged_queues="$(merge_queue_csv "${current_queues:-simulations}" "simulations,requeued")"

  if [[ "$merged_queues" == "$current_queues" && "$env_lines" == *"QUEUE=${merged_queues}"* ]]; then
    log "Worker queue env already includes requeued (${merged_queues})"
    return 0
  fi

  log "Patching worker queues to ${merged_queues}"
  kubectl -n "$NAMESPACE" set env deployment/worker "QUEUES=${merged_queues}" "QUEUE=${merged_queues}" >/dev/null
  kubectl -n "$NAMESPACE" rollout status deployment/worker --timeout=300s >/dev/null
}

acquire_recovery_lock() {
  local redis_pod lock_value lock_result
  redis_pod="$(get_redis_pod)"
  RECOVERY_LOCK_KEY="openstudio:recovery:stuck:${NAMESPACE}:${RELEASE}"
  lock_value="$(date +%s)-$$"
  lock_result="$(
    kubectl -n "$NAMESPACE" exec "$redis_pod" -- sh -lc "
      PW=\"\${REDIS_PASSWORD:-}\"
      AUTH=\"\"
      [ -n \"\$PW\" ] && AUTH=\"-a \$PW --no-auth-warning\"
      redis-cli \$AUTH SET '${RECOVERY_LOCK_KEY}' '${lock_value}' NX EX '${RECOVERY_LOCK_TTL_SECONDS}'
    " | tr -d '\r'
  )"
  [[ "$lock_result" == "OK" ]] || die "Could not acquire recovery lock (${RECOVERY_LOCK_KEY}); another recovery may be running"
  log "Acquired recovery lock (${RECOVERY_LOCK_KEY})"
}

release_recovery_lock() {
  local redis_pod
  [[ -n "${RECOVERY_LOCK_KEY}" ]] || return 0
  redis_pod="$(get_redis_pod)"
  kubectl -n "$NAMESPACE" exec "$redis_pod" -- sh -lc "
    PW=\"\${REDIS_PASSWORD:-}\"
    AUTH=\"\"
    [ -n \"\$PW\" ] && AUTH=\"-a \$PW --no-auth-warning\"
    redis-cli \$AUTH DEL '${RECOVERY_LOCK_KEY}' >/dev/null
  " >/dev/null 2>&1 || true
  log "Released recovery lock (${RECOVERY_LOCK_KEY})"
}

assess_mutation_preconditions() {
  local events class_counts sandbox_count image_count metric_count
  local worker_readiness desired ready available ratio_percent worker_blocker
  local reason_codes mutation_allowed

  events="$(get_recent_warning_events)"
  class_counts="$(get_platform_warning_event_counts "$events")"
  sandbox_count="$(extract_count_from_kv "pod_sandbox_network" "$class_counts")"
  image_count="$(extract_count_from_kv "image_pull_auth" "$class_counts")"
  metric_count="$(extract_count_from_kv "external_metric" "$class_counts")"

  worker_readiness="$(get_worker_readiness_snapshot)"
  desired="$(extract_count_from_kv "desired" "$worker_readiness")"
  ready="$(extract_count_from_kv "ready" "$worker_readiness")"
  available="$(extract_count_from_kv "available" "$worker_readiness")"
  ratio_percent="$(extract_count_from_kv "ratio_percent" "$worker_readiness")"
  worker_blocker="$(extract_count_from_kv "blocker" "$worker_readiness")"

  reason_codes=""
  if (( sandbox_count >= EVENT_HARD_BLOCKER_THRESHOLD )); then
    reason_codes="$(merge_queue_csv "$reason_codes" "platform_pod_sandbox_network_blocked")"
  fi
  if (( image_count >= EVENT_SOFT_BLOCKER_THRESHOLD )); then
    reason_codes="$(merge_queue_csv "$reason_codes" "platform_image_pull_auth_blocked")"
  fi
  if (( metric_count >= EVENT_SOFT_BLOCKER_THRESHOLD )); then
    reason_codes="$(merge_queue_csv "$reason_codes" "platform_external_metrics_blocked")"
  fi
  if (( worker_blocker > 0 )); then
    reason_codes="$(merge_queue_csv "$reason_codes" "worker_readiness_blocked")"
  fi
  reason_codes="$(normalize_hold_reason_codes "$reason_codes")"

  mutation_allowed=true
  if [[ -n "$reason_codes" ]]; then
    mutation_allowed=false
  fi

  echo "mutation_allowed=${mutation_allowed}"
  echo "reason_codes=${reason_codes}"
  echo "pod_sandbox_network=${sandbox_count}"
  echo "image_pull_auth=${image_count}"
  echo "external_metric=${metric_count}"
  echo "worker_desired=${desired}"
  echo "worker_ready=${ready}"
  echo "worker_available=${available}"
  echo "worker_ratio_percent=${ratio_percent}"
}

recover_stuck_state() {
  local web_pod preconditions reason_codes mutation_allowed
  local sandbox_count image_count metric_count worker_desired worker_ready worker_available worker_ratio_percent
  [[ "$APPLY" == "true" ]] || die "Refusing to mutate without --apply"
  require_release_exists
  [[ "$STALE_THRESHOLD_MINUTES" =~ ^[0-9]+$ ]] || die "--stale-minutes must be an integer"
  (( STALE_THRESHOLD_MINUTES >= 10 )) || die "--stale-minutes must be >= 10"

  preconditions="$(assess_mutation_preconditions)"
  mutation_allowed="$(grep '^mutation_allowed=' <<<"$preconditions" | sed 's/^mutation_allowed=//' || true)"
  reason_codes="$(grep '^reason_codes=' <<<"$preconditions" | sed 's/^reason_codes=//' || true)"
  sandbox_count="$(extract_count_from_kv "pod_sandbox_network" "$preconditions")"
  image_count="$(extract_count_from_kv "image_pull_auth" "$preconditions")"
  metric_count="$(extract_count_from_kv "external_metric" "$preconditions")"
  worker_desired="$(extract_count_from_kv "worker_desired" "$preconditions")"
  worker_ready="$(extract_count_from_kv "worker_ready" "$preconditions")"
  worker_available="$(extract_count_from_kv "worker_available" "$preconditions")"
  worker_ratio_percent="$(extract_count_from_kv "worker_ratio_percent" "$preconditions")"
  if [[ "$mutation_allowed" != "true" ]]; then
    die "Mutation hold: recover-stuck skipped due to platform blockers/readiness (codes=${reason_codes:-none}; pod_sandbox_network=${sandbox_count}; image_pull_auth=${image_count}; external_metric=${metric_count}; worker=${worker_ready}/${worker_desired} ready, available=${worker_available}, ratio=${worker_ratio_percent}% min=${WORKER_READINESS_MIN_RATIO_PERCENT}%)"
  fi

  acquire_recovery_lock
  trap 'release_recovery_lock' EXIT

  log "Running stuck-state recovery with stale threshold ${STALE_THRESHOLD_MINUTES}m"
  ensure_worker_requeue_subscription
  run_snapshot_mode

  web_pod="$(get_web_pod)"
  kubectl -n "$NAMESPACE" exec "$web_pod" -- bash -lc "
    cd /opt/openstudio/server
    ANALYSIS_ID='${ANALYSIS_ID}' STALE_MINUTES='${STALE_THRESHOLD_MINUTES}' bundle exec rails runner '
      stale = ENV.fetch(%q(STALE_MINUTES), %q(70)).to_i
      cutoff = Time.now - stale.minutes
      aid = ENV[%q(ANALYSIS_ID)]
      stale_jobs = Job.where(status: %q(started), analysis_type: %q(batch_run), :updated_at.lt => cutoff)
      stale_jobs = stale_jobs.where(analysis_id: aid) if aid && !aid.empty?
      started_analysis_ids = Analysis.all.select { |a| a.status == %q(started) }.map(&:id)
      if aid && !aid.empty?
        started_analysis_ids = started_analysis_ids.select { |analysis_id| analysis_id.to_s == aid.to_s }
      end
      stale_dps = DataPoint.where(:analysis_id.in => started_analysis_ids, :status.in => [%q(started), %q(na)], :updated_at.lt => cutoff)
      stale_analysis_ids = (stale_jobs.pluck(:analysis_id) + stale_dps.pluck(:analysis_id)).uniq
      requeued_started = 0
      requeued_na = 0
      finalized = 0
      zero_datapoint_jobs_failed = 0
      zero_datapoint_analyses_flagged = 0
      zero_datapoint_missing_seed = 0
      zero_datapoint_seed_present = 0
      stale_analysis_ids.each do |aid|
        DataPoint.where(analysis_id: aid, :status.in => [%q(started), %q(na)], :updated_at.lt => cutoff).each do |dp|
          Resque.enqueue(ResqueJobs::RunSimulateDataPoint, dp.id)
          if dp.status == %q(na)
            requeued_na += 1
          else
            requeued_started += 1
          end
        end
      end
      stale_jobs.each do |job|
        remaining = DataPoint.where(analysis_id: job.analysis_id, :status.in => [%q(na), %q(queued), %q(started)]).count
        total_datapoints = DataPoint.where(analysis_id: job.analysis_id).count
        next unless remaining == 0
        next unless total_datapoints > 0
        next unless job.status == %q(started)
        job.status = %q(completed)
        job.end_time ||= Time.now
        job.save!
        Resque.enqueue(ResqueJobs::FinalizeAnalysis, job.analysis_id)
        finalized += 1
      end

      terminal_jobs = Job.where(:status.ne => %q(completed), status_message: %q(post-processing finished))
      terminal_jobs = terminal_jobs.where(analysis_id: aid) if aid && !aid.empty?
      terminal_promoted = 0
      terminal_jobs.each do |job|
        remaining = DataPoint.where(analysis_id: job.analysis_id, :status.in => [%q(na), %q(queued), %q(started)]).count
        total_datapoints = DataPoint.where(analysis_id: job.analysis_id).count
        next unless remaining == 0
        next unless total_datapoints > 0
        next unless job.status != %q(completed)
        job.status = %q(completed)
        job.end_time ||= Time.now
        job.save!
        terminal_promoted += 1
      end

      zero_datapoint_jobs = Job.where(:status.in => [%q(started), %q(queued), %q(completed)], :updated_at.lt => cutoff)
      zero_datapoint_jobs = zero_datapoint_jobs.where(analysis_id: aid) if aid && !aid.empty?
      zero_datapoint_analysis_ids = zero_datapoint_jobs.pluck(:analysis_id).uniq.select do |analysis_id|
        DataPoint.where(analysis_id: analysis_id).count == 0
      end

      zero_datapoint_analysis_ids.each do |analysis_id|
        analysis = Analysis.where(id: analysis_id).first
        missing_seed_zip = analysis.nil? || analysis.seed_zip_file_name.to_s.strip.empty?
        if missing_seed_zip
          zero_datapoint_missing_seed += 1
        else
          zero_datapoint_seed_present += 1
        end

        analysis_message =
          if missing_seed_zip
            %q(missing seed_zip attachment; re-upload required before lhs/batch_run can create datapoints)
          else
            %q(no datapoints were created for this analysis; seed_zip is present, investigate analysis initialization payload/options)
          end

        Job.where(analysis_id: analysis_id, :status.ne => %q(failed)).each do |job|
          job.status = %q(failed)
          job.status_message = analysis_message
          job.end_time ||= Time.now
          job.save!
          zero_datapoint_jobs_failed += 1
        end

        next if analysis.nil?
        analysis.status_message = analysis_message
        analysis.save!
        zero_datapoint_analyses_flagged += 1
      end

      puts %(recovery_summary stale_analyses=#{stale_analysis_ids.count} datapoints_requeued_started=#{requeued_started} datapoints_requeued_na=#{requeued_na} datapoints_requeued_total=#{requeued_started + requeued_na} jobs_finalized=#{finalized} terminal_jobs_promoted=#{terminal_promoted} zero_datapoint_jobs_failed=#{zero_datapoint_jobs_failed} zero_datapoint_analyses_flagged=#{zero_datapoint_analyses_flagged} zero_datapoint_missing_seed=#{zero_datapoint_missing_seed} zero_datapoint_seed_present=#{zero_datapoint_seed_present})
    '
  "

  log "Post-recovery checks"
  read_redis_queues
  read_divergence_signals
  read_app_job_counts
  read_analysis_focus
}

run_check_mode() {
  log "Running read-only reliability checks for ${NAMESPACE}/${RELEASE}"
  read_helm_state
  echo "---"
  read_nfs_usage
  echo "---"
  read_pvc_storage_classes
  echo "---"
  read_redis_queues
  echo "---"
  read_queue_pipeline_health
  echo "---"
  read_app_job_counts
  echo "---"
  read_web_auth_signals
  echo "---"
  read_divergence_signals
  if [[ -n "${ANALYSIS_ID}" ]]; then
    echo "---"
    read_analysis_focus
  fi
  echo "---"
  read_recent_warning_event_signals
  echo "---"
  read_platform_blocker_summary
  echo "---"
  read_loadbalancer_event_signals
  echo "---"
  read_node_memory_pressure_state
  echo "---"
  read_calico_node_qos_state
  echo "---"
  read_web_background_state
  echo "---"
  read_keda_state
  echo "---"
  read_worker_state
}

run_snapshot_mode() {
  local out_dir redis_pod web_pod ts worker_hpa
  ts="$(date +%Y%m%d-%H%M%S)"
  out_dir="${SNAPSHOT_DIR:-./incident-snapshots/${RELEASE}-${ts}}"
  mkdir -p "$out_dir"

  redis_pod="$(get_redis_pod)"
  web_pod="$(get_web_pod)"
  worker_hpa="$(get_worker_hpa_name 2>/dev/null)" || worker_hpa=""

  log "Writing snapshots into ${out_dir}"
  kubectl config current-context > "${out_dir}/kube_context.txt"
  helm status "$RELEASE" -n "$NAMESPACE" > "${out_dir}/helm_status.txt"
  helm history "$RELEASE" -n "$NAMESPACE" > "${out_dir}/helm_history.txt"
  if [[ -n "$worker_hpa" ]]; then
    kubectl -n "$NAMESPACE" get hpa "$worker_hpa" -o wide > "${out_dir}/worker_hpa.txt"
  else
    echo "no worker HPA object found (KEDA ScaledObject likely paused; HPA is not materialized while paused)" > "${out_dir}/worker_hpa.txt"
  fi
  kubectl -n "$NAMESPACE" get deploy worker -o wide > "${out_dir}/worker_deploy.txt"

  kubectl -n "$NAMESPACE" exec "$redis_pod" -- sh -lc '
    PW="${REDIS_PASSWORD:-}"
    AUTH=""
    if [ -n "$PW" ]; then AUTH="-a $PW --no-auth-warning"; fi
    for q in analyses analysis_wrappers simulations background requeued; do
      printf "%s=" "$q"
      redis-cli $AUTH LLEN "resque:queue:$q"
    done
    printf "failed="
    redis-cli $AUTH LLEN resque:failed
  ' > "${out_dir}/queue_depths.txt"
  collect_failed_queue_triage "$redis_pod" "$out_dir"

  kubectl -n "$NAMESPACE" exec "$web_pod" -- bash -lc '
    cd /opt/openstudio/server
    bundle exec rails runner "Job.where(status: \"queued\").limit(200).pluck(:_id, :analysis_id, :analysis_type, :status).each { |r| puts r.join(\"\t\") }"
  ' > "${out_dir}/queued_jobs.tsv"

  kubectl -n "$NAMESPACE" exec "$web_pod" -- bash -lc '
    cd /opt/openstudio/server
    bundle exec rails runner "puts %(queued=#{Job.where(status: \"queued\").count} started=#{Job.where(status: \"started\").count} running=#{Job.where(status: \"running\").count} completed=#{Job.where(status: \"completed\").count} failed=#{Job.where(status: \"failed\").count} na=#{Job.where(status: \"na\").count})"
  ' > "${out_dir}/job_counts.txt"

  kubectl -n "$NAMESPACE" exec "$web_pod" -- bash -lc '
    cd /opt/openstudio/server
    bundle exec rails runner "Job.collection.aggregate([{\"\$group\"=>{\"_id\"=>\"\$status\",\"count\"=>{\"\$sum\"=>1}}},{\"\$sort\"=>{\"_id\"=>1}}]).each { |r| puts \"#{r[\"_id\"]}\t#{r[\"count\"]}\" }"
  ' > "${out_dir}/job_status_counts.tsv"

  kubectl -n "$NAMESPACE" exec "$web_pod" -- bash -lc '
    cd /opt/openstudio/server
    bundle exec rails runner "DataPoint.collection.aggregate([{\"\$group\"=>{\"_id\"=>\"\$status\",\"count\"=>{\"\$sum\"=>1}}},{\"\$sort\"=>{\"_id\"=>1}}]).each { |r| puts \"#{r[\"_id\"]}\t#{r[\"count\"]}\" }"
  ' > "${out_dir}/datapoint_status_counts.tsv"

  kubectl -n "$NAMESPACE" exec "$web_pod" -- bash -lc "
    cd /opt/openstudio/server
    STALE_MINUTES='${STALE_THRESHOLD_MINUTES}' bundle exec rails runner '
      stale = ENV.fetch(%q(STALE_MINUTES), %q(70)).to_i
      cutoff = Time.now - stale.minutes
      Job.where(status: %q(started), :updated_at.lt => cutoff).limit(500).pluck(:_id, :analysis_id, :analysis_type, :updated_at).each { |r| puts r.join(\"\t\") }
    '
  " > "${out_dir}/stale_started_jobs.tsv"

  kubectl -n "$NAMESPACE" exec "$web_pod" -- bash -lc "
    cd /opt/openstudio/server
    STALE_MINUTES='${STALE_THRESHOLD_MINUTES}' bundle exec rails runner '
      stale = ENV.fetch(%q(STALE_MINUTES), %q(70)).to_i
      cutoff = Time.now - stale.minutes
      started_analysis_ids = Analysis.all.select { |a| a.status == %q(started) }.map(&:id)
      DataPoint.where(:analysis_id.in => started_analysis_ids, status: %q(started), :updated_at.lt => cutoff).limit(2000).pluck(:_id, :analysis_id, :updated_at).each { |r| puts r.join(\"\t\") }
    '
  " > "${out_dir}/stale_started_datapoints.tsv"

  kubectl -n "$NAMESPACE" exec "$web_pod" -- bash -lc "
    cd /opt/openstudio/server
    STALE_MINUTES='${STALE_THRESHOLD_MINUTES}' bundle exec rails runner '
      stale = ENV.fetch(%q(STALE_MINUTES), %q(70)).to_i
      cutoff = Time.now - stale.minutes
      started_analysis_ids = Analysis.all.select { |a| a.status == %q(started) }.map(&:id)
      DataPoint.where(:analysis_id.in => started_analysis_ids, status: %q(na), :updated_at.lt => cutoff).limit(2000).pluck(:_id, :analysis_id, :updated_at).each { |r| puts r.join(\"\t\") }
    '
  " > "${out_dir}/stale_na_datapoints.tsv"

  if [[ -n "${ANALYSIS_ID}" ]]; then
    kubectl -n "$NAMESPACE" exec "$web_pod" -- bash -lc "
      cd /opt/openstudio/server
      ANALYSIS_ID='${ANALYSIS_ID}' STALE_MINUTES='${STALE_THRESHOLD_MINUTES}' bundle exec rails runner '
        aid = ENV.fetch(%q(ANALYSIS_ID))
        stale = ENV.fetch(%q(STALE_MINUTES), %q(70)).to_i
        cutoff = Time.now - stale.minutes
        analysis = Analysis.where(id: aid).first
        if analysis.nil?
          puts %(analysis_focus analysis_id=#{aid} found=false)
          exit 0
        end
        stale_started = DataPoint.where(analysis_id: aid, status: %q(started), :updated_at.lt => cutoff).count
        stale_na = DataPoint.where(analysis_id: aid, status: %q(na), :updated_at.lt => cutoff).count
        puts %(analysis_focus analysis_id=#{aid} found=true analysis_status=#{analysis.status} stale_started_datapoints=#{stale_started} stale_na_datapoints=#{stale_na} jobs_total=#{Job.where(analysis_id: aid).count} datapoints_total=#{DataPoint.where(analysis_id: aid).count})
      '
    " > "${out_dir}/analysis_focus.txt"
  fi

  log "Snapshot complete: ${out_dir}"
}

run_review_non_completed_mode() {
  local out_dir ts redis_pod web_pod detail_raw_json detail_json summary_md baseline_json candidates_tsv
  local job_raw_json job_inventory_json job_inventory_tsv
  local queue_depths problem_counts warning_events
  local queue_blockers core_blockers node_blockers problem_pod_total
  local hard_event_total soft_event_total stale_minutes
  local failed_queue_depth
  local platform_counts platform_pod_sandbox_network platform_image_pull_auth failed_pull_secret platform_external_metric
  local worker_readiness worker_desired worker_ready worker_available worker_ratio_percent worker_readiness_blocker
  local platform_reason_codes platform_blockers_active

  stale_minutes="$STALE_THRESHOLD_MINUTES"
  [[ "$stale_minutes" =~ ^[0-9]+$ ]] || die "--stale-minutes must be an integer"
  (( stale_minutes >= 10 )) || die "--stale-minutes must be >= 10"

  ts="$(date +%Y%m%d-%H%M%S)"
  out_dir="${SNAPSHOT_DIR:-./incident-snapshots/${RELEASE}-review-non-completed-${ts}}"
  mkdir -p "$out_dir"

  detail_raw_json="${out_dir}/non_completed_analyses_raw.json"
  detail_json="${out_dir}/non_completed_analysis_details.json"
  summary_md="${out_dir}/non_completed_summary.md"
  baseline_json="${out_dir}/baseline_signals.json"
  candidates_tsv="${out_dir}/non_completed_candidates.tsv"
  job_raw_json="${out_dir}/non_completed_jobs_raw.json"
  job_inventory_json="${out_dir}/non_completed_job_inventory.json"
  job_inventory_tsv="${out_dir}/non_completed_job_inventory.tsv"

  redis_pod="$(get_redis_pod)"
  web_pod="$(get_web_pod)"

  log "Reviewing non-completed analyses (all statuses except completed)"
  log "Writing review artifacts into ${out_dir}"

  kubectl config current-context > "${out_dir}/kube_context.txt"
  helm status "$RELEASE" -n "$NAMESPACE" > "${out_dir}/helm_status.txt"
  helm history "$RELEASE" -n "$NAMESPACE" > "${out_dir}/helm_history.txt"
  kubectl -n "$NAMESPACE" get deploy web web-background redis rserve worker -o wide > "${out_dir}/core_deployments.txt"
  kubectl -n "$NAMESPACE" get pods -l "release=${RELEASE}" -o wide > "${out_dir}/release_pods_wide.txt"
  kubectl get nodes \
    -o 'custom-columns=NAME:.metadata.name,READY:.status.conditions[?(@.type=="Ready")].status,MEMORY:.status.conditions[?(@.type=="MemoryPressure")].status,DISK:.status.conditions[?(@.type=="DiskPressure")].status,PID:.status.conditions[?(@.type=="PIDPressure")].status' \
    > "${out_dir}/node_health.txt"

  queue_depths="$(
    kubectl -n "$NAMESPACE" exec "$redis_pod" -- sh -lc '
      PW="${REDIS_PASSWORD:-}"
      AUTH=""
      if [ -n "$PW" ]; then AUTH="-a $PW --no-auth-warning"; fi
      for q in analyses analysis_wrappers simulations background requeued; do
        printf "%s=" "$q"
        redis-cli $AUTH LLEN "resque:queue:$q"
      done
      printf "failed="
      redis-cli $AUTH LLEN resque:failed
    ' | tr -d '\r'
  )"
  printf "%s\n" "$queue_depths" > "${out_dir}/queue_depths.txt"
  failed_queue_depth="$(grep '^failed=' <<<"$queue_depths" | sed 's/^failed=//' || true)"
  [[ "$failed_queue_depth" =~ ^[0-9]+$ ]] || failed_queue_depth=0
  collect_failed_queue_triage "$redis_pod" "$out_dir"

  problem_counts="$(get_problem_pod_counts)"
  printf "%s\n" "$problem_counts" > "${out_dir}/problem_pod_counts.txt"
  problem_pod_total="$(grep '^total=' <<<"$problem_counts" | sed 's/^total=//' || true)"
  [[ "$problem_pod_total" =~ ^[0-9]+$ ]] || problem_pod_total=0

  warning_events="$(get_recent_warning_events)"
  printf "%s\n" "$warning_events" > "${out_dir}/warning_events_recent.tsv"
  hard_event_total="$(grep -ciE 'FailedCreatePodSandBox|failed to sync secret cache|SystemOOM|OOMKilled|OOMKilling|failed liveness probe|liveness probe failed' <<<"$warning_events" || true)"
  soft_event_total="$(grep -ciE 'NodeNotReady|NetworkNotReady|ImagePullBackOff|ErrImagePull|FailedToRetrieveImagePullSecret|FailedGetExternalMetric|failed to get external metric|503 Service Unavailable|SyncLoadBalancerFailed' <<<"$warning_events" || true)"
  [[ "$hard_event_total" =~ ^[0-9]+$ ]] || hard_event_total=0
  [[ "$soft_event_total" =~ ^[0-9]+$ ]] || soft_event_total=0

  platform_counts="$(get_platform_warning_event_counts "$warning_events")"
  platform_pod_sandbox_network="$(extract_count_from_kv "pod_sandbox_network" "$platform_counts")"
  platform_image_pull_auth="$(extract_count_from_kv "image_pull_auth" "$platform_counts")"
  failed_pull_secret="$(extract_count_from_kv "failed_pull_secret" "$platform_counts")"
  platform_external_metric="$(extract_count_from_kv "external_metric" "$platform_counts")"

  worker_readiness="$(get_worker_readiness_snapshot)"
  worker_desired="$(extract_count_from_kv "desired" "$worker_readiness")"
  worker_ready="$(extract_count_from_kv "ready" "$worker_readiness")"
  worker_available="$(extract_count_from_kv "available" "$worker_readiness")"
  worker_ratio_percent="$(extract_count_from_kv "ratio_percent" "$worker_readiness")"
  worker_readiness_blocker="$(extract_count_from_kv "blocker" "$worker_readiness")"

  platform_reason_codes=""
  if (( platform_pod_sandbox_network >= EVENT_HARD_BLOCKER_THRESHOLD )); then
    platform_reason_codes="$(merge_queue_csv "$platform_reason_codes" "platform_pod_sandbox_network_blocked")"
  fi
  if (( platform_image_pull_auth >= EVENT_SOFT_BLOCKER_THRESHOLD )); then
    platform_reason_codes="$(merge_queue_csv "$platform_reason_codes" "platform_image_pull_auth_blocked")"
  fi
  if (( platform_external_metric >= EVENT_SOFT_BLOCKER_THRESHOLD )); then
    platform_reason_codes="$(merge_queue_csv "$platform_reason_codes" "platform_external_metrics_blocked")"
  fi
  if (( worker_readiness_blocker > 0 )); then
    platform_reason_codes="$(merge_queue_csv "$platform_reason_codes" "worker_readiness_blocked")"
  fi
  platform_reason_codes="$(normalize_hold_reason_codes "$platform_reason_codes")"
  platform_blockers_active=false
  if [[ -n "$platform_reason_codes" ]]; then
    platform_blockers_active=true
  fi

  queue_blockers="$(count_queue_pipeline_blockers)"
  core_blockers="$(count_core_service_readiness_blockers)"
  node_blockers="$(count_node_health_blockers)"
  [[ "$queue_blockers" =~ ^[0-9]+$ ]] || queue_blockers=0
  [[ "$core_blockers" =~ ^[0-9]+$ ]] || core_blockers=0
  [[ "$node_blockers" =~ ^[0-9]+$ ]] || node_blockers=0

  jq -n \
    --arg generated_at "$(date -Iseconds)" \
    --arg namespace "$NAMESPACE" \
    --arg release "$RELEASE" \
    --arg stale_minutes "$stale_minutes" \
    --arg event_window_seconds "$EVENT_WINDOW_SECONDS" \
    --arg event_hard_threshold "$EVENT_HARD_BLOCKER_THRESHOLD" \
    --arg event_soft_threshold "$EVENT_SOFT_BLOCKER_THRESHOLD" \
    --arg problem_pod_threshold "$PROBLEM_POD_BLOCKER_THRESHOLD" \
    --argjson queue_blockers "$queue_blockers" \
    --argjson core_blockers "$core_blockers" \
    --argjson node_blockers "$node_blockers" \
    --argjson problem_pod_total "$problem_pod_total" \
    --argjson hard_event_total "$hard_event_total" \
    --argjson soft_event_total "$soft_event_total" \
    --argjson failed_queue_depth "$failed_queue_depth" \
    --argjson platform_pod_sandbox_network "$platform_pod_sandbox_network" \
    --argjson platform_image_pull_auth "$platform_image_pull_auth" \
    --argjson failed_pull_secret "$failed_pull_secret" \
    --argjson platform_external_metric "$platform_external_metric" \
    --argjson worker_desired "$worker_desired" \
    --argjson worker_ready "$worker_ready" \
    --argjson worker_available "$worker_available" \
    --argjson worker_ratio_percent "$worker_ratio_percent" \
    --argjson worker_readiness_blocker "$worker_readiness_blocker" \
    --arg platform_reason_codes "$platform_reason_codes" \
    --argjson platform_blockers_active "$platform_blockers_active" \
    '{
      generated_at: $generated_at,
      namespace: $namespace,
      release: $release,
      stale_minutes: ($stale_minutes | tonumber),
      event_window_seconds: ($event_window_seconds | tonumber),
      event_hard_threshold: ($event_hard_threshold | tonumber),
      event_soft_threshold: ($event_soft_threshold | tonumber),
      problem_pod_threshold: ($problem_pod_threshold | tonumber),
      queue_pipeline_blockers: $queue_blockers,
      core_service_blockers: $core_blockers,
      node_health_blockers: $node_blockers,
      problem_pod_total: $problem_pod_total,
      hard_warning_event_total: $hard_event_total,
      soft_warning_event_total: $soft_event_total,
      failed_queue_depth: $failed_queue_depth,
      platform_blocker_thresholds: {
        pod_sandbox_network: ($event_hard_threshold | tonumber),
        image_pull_auth: ($event_soft_threshold | tonumber),
        external_metric: ($event_soft_threshold | tonumber),
        worker_readiness_min_ratio_percent: 50
      },
      platform_blocker_classes: {
        pod_sandbox_network_failures: $platform_pod_sandbox_network,
        image_pull_auth_failures: $platform_image_pull_auth,
        failed_to_retrieve_image_pull_secret: $failed_pull_secret,
        external_metric_failures: $platform_external_metric
      },
      worker_readiness: {
        desired_replicas: $worker_desired,
        ready_replicas: $worker_ready,
        available_replicas: $worker_available,
        ready_ratio_percent: $worker_ratio_percent,
        blocker: $worker_readiness_blocker
      },
      platform_blockers_active: $platform_blockers_active,
      platform_blocker_reason_codes: (
        if ($platform_reason_codes | length) == 0 then [] else ($platform_reason_codes | split(",")) end
      )
    }' > "$baseline_json"

  kubectl -n "$NAMESPACE" exec "$web_pod" -- bash -lc "
    cd /opt/openstudio/server
    STALE_MINUTES='${stale_minutes}' bundle exec rails runner '
      require %q(json)
      stale = ENV.fetch(%q(STALE_MINUTES), %q(70)).to_i
      now = Time.now
      cutoff = now - stale.minutes
      analyses = Analysis.all.select { |analysis| analysis.status.to_s != %q(completed) }.sort_by { |a| [a.status.to_s, a.id.to_s] }
      analysis_ids = analyses.map { |a| a.id.to_s }

      job_statuses = Hash.new { |h, k| h[k] = Hash.new(0) }
      datapoint_statuses = Hash.new { |h, k| h[k] = Hash.new(0) }
      stale_started_counts = Hash.new(0)
      stale_na_counts = Hash.new(0)
      recent_job_updates = Hash.new(0)
      recent_datapoint_updates = Hash.new(0)

      unless analysis_ids.empty?
        Job.where(:analysis_id.in => analysis_ids).only(:analysis_id, :status, :updated_at).each do |job|
          aid = job.analysis_id.to_s
          status = (job.status || %q(nil)).to_s
          job_statuses[aid][status] += 1
          recent_job_updates[aid] += 1 if job.updated_at && job.updated_at >= cutoff
        end
        DataPoint.where(:analysis_id.in => analysis_ids).only(:analysis_id, :status, :updated_at).each do |dp|
          aid = dp.analysis_id.to_s
          status = (dp.status || %q(nil)).to_s
          datapoint_statuses[aid][status] += 1
          recent_datapoint_updates[aid] += 1 if dp.updated_at && dp.updated_at >= cutoff
          if dp.updated_at && dp.updated_at < cutoff
            stale_started_counts[aid] += 1 if status == %q(started)
            stale_na_counts[aid] += 1 if status == %q(na)
          end
        end
      end

      rows = analyses.map do |analysis|
        aid = analysis.id.to_s
        updated_at = analysis.updated_at
        age_minutes = updated_at.nil? ? nil : ((now - updated_at) / 60).floor
        {
          analysis_id: aid,
          analysis_status: analysis.status.to_s,
          age_minutes: age_minutes,
          updated_at: updated_at&.utc&.iso8601,
          stale_started_datapoints: stale_started_counts[aid] || 0,
          stale_na_datapoints: stale_na_counts[aid] || 0,
          recent_job_updates: recent_job_updates[aid] || 0,
          recent_datapoint_updates: recent_datapoint_updates[aid] || 0,
          job_statuses: Hash[(job_statuses[aid] || {}).sort_by { |k, _| k.to_s }],
          datapoint_statuses: Hash[(datapoint_statuses[aid] || {}).sort_by { |k, _| k.to_s }]
        }
      end

      puts JSON.pretty_generate(rows)
    '
  " | sed '/MONGODB | Unsupported client option/d' > "$detail_raw_json"

  # Deterministic blocker precedence:
  # core_service_blocker > worker_capacity_blocker > queue_pipeline_blocker > data_divergence_blocker > no_explicit_blocker_detected
  jq \
    --argjson stale_minutes "$stale_minutes" \
    --argjson queue_blockers "$queue_blockers" \
    --argjson core_blockers "$core_blockers" \
    --argjson node_blockers "$node_blockers" \
    --argjson problem_pod_total "$problem_pod_total" \
    --argjson problem_pod_threshold "$PROBLEM_POD_BLOCKER_THRESHOLD" \
    --argjson hard_event_total "$hard_event_total" \
    --argjson soft_event_total "$soft_event_total" \
    --argjson platform_pod_sandbox_network "$platform_pod_sandbox_network" \
    --argjson platform_image_pull_auth "$platform_image_pull_auth" \
    --argjson platform_external_metric "$platform_external_metric" \
    --argjson event_hard_threshold "$EVENT_HARD_BLOCKER_THRESHOLD" \
    --argjson event_soft_threshold "$EVENT_SOFT_BLOCKER_THRESHOLD" \
    --argjson worker_readiness_blocker "$worker_readiness_blocker" \
    '
    map(
      .analysis_status = (.analysis_status // "unknown")
      | .age_minutes = (.age_minutes // 0)
      | .stale_started_datapoints = (.stale_started_datapoints // 0)
      | .stale_na_datapoints = (.stale_na_datapoints // 0)
      | .recent_job_updates = (.recent_job_updates // 0)
      | .recent_datapoint_updates = (.recent_datapoint_updates // 0)
      | .job_statuses = (.job_statuses // {})
      | .datapoint_statuses = (.datapoint_statuses // {})
      | ._global_signals = [
          (if $core_blockers > 0 then "core_services_unready=\($core_blockers)" else empty end),
          (if $node_blockers > 0 then "node_health_blockers=\($node_blockers)" else empty end),
          (if $problem_pod_total >= $problem_pod_threshold then "problem_pods=\($problem_pod_total)" else empty end),
          (if $hard_event_total >= $event_hard_threshold then "hard_warning_events=\($hard_event_total)" else empty end),
          (if $soft_event_total >= $event_soft_threshold then "soft_warning_events=\($soft_event_total)" else empty end),
          (if $platform_pod_sandbox_network >= $event_hard_threshold then "platform_pod_sandbox_network=\($platform_pod_sandbox_network)" else empty end),
          (if $platform_image_pull_auth >= $event_soft_threshold then "platform_image_pull_auth=\($platform_image_pull_auth)" else empty end),
          (if $platform_external_metric >= $event_soft_threshold then "platform_external_metric=\($platform_external_metric)" else empty end),
          (if $queue_blockers > 0 then "queue_pipeline_blockers=\($queue_blockers)" else empty end)
        ]
      | ._analysis_signals = [
          (if .stale_started_datapoints > 0 then "stale_started_datapoints=\(.stale_started_datapoints)" else empty end),
          (if .stale_na_datapoints > 0 then "stale_na_datapoints=\(.stale_na_datapoints)" else empty end),
          (if ((.recent_job_updates + .recent_datapoint_updates) == 0 and .age_minutes >= $stale_minutes) then "no_recent_lifecycle_updates" else empty end)
        ]
      | .divergence_cohort = (
          if (.stale_started_datapoints > 0 or .stale_na_datapoints > 0) and .analysis_status == "started" then "active_stalled_datapoints"
          elif (.stale_started_datapoints > 0 or .stale_na_datapoints > 0) then "orphaned_stale_datapoints"
          elif (.age_minutes >= $stale_minutes and (.recent_job_updates + .recent_datapoint_updates) == 0 and $queue_blockers == 0 and $core_blockers == 0 and $node_blockers == 0 and $problem_pod_total < $problem_pod_threshold and $hard_event_total < $event_hard_threshold and $soft_event_total < $event_soft_threshold and $platform_pod_sandbox_network < $event_hard_threshold and $platform_image_pull_auth < $event_soft_threshold and $platform_external_metric < $event_soft_threshold and $worker_readiness_blocker == 0) then "no_forward_progress_with_healthy_pipeline"
          else "none"
          end
        )
      | .blocker_category = (
          if $core_blockers > 0 then "core_service_blocker"
          elif ($node_blockers > 0 or $problem_pod_total >= $problem_pod_threshold or $hard_event_total >= $event_hard_threshold or $soft_event_total >= $event_soft_threshold or $platform_pod_sandbox_network >= $event_hard_threshold or $platform_image_pull_auth >= $event_soft_threshold or $platform_external_metric >= $event_soft_threshold) then "worker_capacity_blocker"
          elif $queue_blockers > 0 then "queue_pipeline_blocker"
          elif (.stale_started_datapoints > 0 or .stale_na_datapoints > 0) then "data_divergence_blocker"
          else "no_explicit_blocker_detected"
          end
        )
      | .blocker_evidence = {
          global: ._global_signals,
          analysis: ._analysis_signals
        }
      | .high_priority = (
          .blocker_category != "no_explicit_blocker_detected"
          and (
            .age_minutes >= $stale_minutes
            or .stale_started_datapoints > 0
            or .stale_na_datapoints > 0
          )
        )
      | del(._global_signals, ._analysis_signals)
    )
    | sort_by(.analysis_status, .analysis_id)
    ' "$detail_raw_json" > "$detail_json"

  jq -r '
    ["analysis_id","analysis_status","age_minutes","updated_at","stale_started_datapoints","stale_na_datapoints"],
    (.[] | [
      .analysis_id,
      .analysis_status,
      (.age_minutes | tostring),
      (.updated_at // ""),
      (.stale_started_datapoints | tostring),
      (.stale_na_datapoints | tostring)
    ])
    | @tsv
  ' "$detail_json" > "$candidates_tsv"

  collect_non_completed_job_inventory "$web_pod" "$out_dir"

  {
    echo "# Non-Completed Analysis Review"
    echo
    echo "- Generated at: $(date -Iseconds)"
    echo "- Namespace: ${NAMESPACE}"
    echo "- Release: ${RELEASE}"
    echo "- Stale threshold (minutes): ${stale_minutes}"
    echo "- Included statuses: all statuses except completed"
    echo
    echo "## Total analyses reviewed"
    echo
    echo "- $(jq 'length' "$detail_json")"
    echo
    echo "## Count by analysis status"
    echo
    jq -r '
      map(.analysis_status)
      | group_by(.)
      | map({status: .[0], count: length})
      | sort_by(.status)
      | .[]
      | "- \(.status): \(.count)"
    ' "$detail_json"
    echo
    echo "## Count by blocker category"
    echo
    for category in queue_pipeline_blocker worker_capacity_blocker data_divergence_blocker core_service_blocker no_explicit_blocker_detected; do
      echo "- ${category}: $(jq --arg category "$category" '[.[] | select(.blocker_category == $category)] | length' "$detail_json")"
    done
    echo
    echo "## High-priority blocked analyses"
    echo
    if [[ "$(jq '[.[] | select(.high_priority == true)] | length' "$detail_json")" == "0" ]]; then
      echo "- None"
    else
      jq -r '
        [.[] | select(.high_priority == true)]
        | sort_by(-(.age_minutes // 0), .analysis_id)
        | .[]
        | "- \(.analysis_id) status=\(.analysis_status) age_minutes=\(.age_minutes) blocker=\(.blocker_category) stale_started=\(.stale_started_datapoints) stale_na=\(.stale_na_datapoints)"
      ' "$detail_json"
    fi
    echo
    echo "## Non-completed job inventory"
    echo
    echo "- Jobs reviewed: $(jq 'length' "$job_inventory_json")"
    echo "- Terminal-but-not-completed jobs: $(jq '[.[] | select(.status_bucket == "terminal_but_not_completed")] | length' "$job_inventory_json")"
    echo "- Actionable jobs: $(jq '[.[] | select(.status_bucket == "actionable")] | length' "$job_inventory_json")"
    echo "- Manual review jobs: $(jq '[.[] | select(.status_bucket == "manual_review")] | length' "$job_inventory_json")"
    echo
    echo "### Recovery-path counts"
    jq -r '
      map(.recovery_path)
      | sort
      | group_by(.)
      | map({path: .[0], count: length})
      | sort_by(.path)
      | .[]
      | "- \(.path): \(.count)"
    ' "$job_inventory_json"
    echo
    echo "### Terminal records eligible for completion"
    if [[ "$(jq '[.[] | select(.status_bucket == "terminal_but_not_completed")] | length' "$job_inventory_json")" == "0" ]]; then
      echo "- None"
    else
      jq -r '
        [.[] | select(.status_bucket == "terminal_but_not_completed")]
        | sort_by(.analysis_id, .job_id)
        | .[]
        | "- \(.job_id) analysis=\(.analysis_id) status=\(.job_status) message=\(.job_status_message) recovery=\(.recovery_path)"
      ' "$job_inventory_json"
    fi
    echo
    echo "### Actionable jobs"
    if [[ "$(jq '[.[] | select(.status_bucket == "actionable")] | length' "$job_inventory_json")" == "0" ]]; then
      echo "- None"
    else
      jq -r '
        [.[] | select(.status_bucket == "actionable")]
        | sort_by(.job_status, .age_minutes, .analysis_id, .job_id)
        | .[]
        | "- \(.job_id) analysis=\(.analysis_id) status=\(.job_status) age_minutes=\(.age_minutes // 0) recovery=\(.recovery_path)"
      ' "$job_inventory_json"
    fi
    echo
    echo "## Platform blocker classes (event-window based)"
    echo
    echo "- pod_sandbox_network_failures: ${platform_pod_sandbox_network} (threshold=${EVENT_HARD_BLOCKER_THRESHOLD})"
    echo "- image_pull_auth_failures: ${platform_image_pull_auth} (threshold=${EVENT_SOFT_BLOCKER_THRESHOLD})"
    echo "- failed_to_retrieve_image_pull_secret: ${failed_pull_secret}"
    echo "- external_metric_failures: ${platform_external_metric} (threshold=${EVENT_SOFT_BLOCKER_THRESHOLD})"
    echo "- worker_readiness: desired=${worker_desired} ready=${worker_ready} available=${worker_available} ratio=${worker_ratio_percent}% (min=${WORKER_READINESS_MIN_RATIO_PERCENT}%)"
    if [[ "$platform_blockers_active" == "true" ]]; then
      echo "- platform_blockers_active: true"
      echo "- platform_blocker_reason_codes: ${platform_reason_codes}"
    else
      echo "- platform_blockers_active: false"
    fi
    echo "- failed_queue_depth: ${failed_queue_depth}"
    echo
    echo "## Data divergence cohorts"
    echo
    jq -r '
      map(.divergence_cohort)
      | sort
      | group_by(.)
      | map({cohort: .[0], count: length})
      | sort_by(.cohort)
      | .[]
      | "- \(.cohort): \(.count)"
    ' "$detail_json"
    echo
    echo "## Analyses with no explicit blocker signal"
    echo
    if [[ "$(jq --arg category "no_explicit_blocker_detected" '[.[] | select(.blocker_category == $category)] | length' "$detail_json")" == "0" ]]; then
      echo "- None"
    else
      jq -r '
        [.[] | select(.blocker_category == "no_explicit_blocker_detected")]
        | sort_by(-(.age_minutes // 0), .analysis_id)
        | .[]
        | "- \(.analysis_id) status=\(.analysis_status) age_minutes=\(.age_minutes)"
      ' "$detail_json"
    fi
    echo
    echo "## Targeted remediation suggestions (read-only guidance)"
    echo
    echo '- queue_pipeline_blocker: verify web-background consumption and enqueue flow (`analyses -> analysis_wrappers -> simulations`) using queue depth deltas and web/web-background logs.'
    echo "- worker_capacity_blocker: review node readiness/pressure, warning-event bursts, and worker pod failure patterns; confirm cluster capacity before raising worker ceilings."
    echo "- data_divergence_blocker: inspect stale started/na datapoints and batch-run job transitions for affected analyses; confirm worker queue subscriptions and datapoint lifecycle advancement."
    echo "- core_service_blocker: restore Ready pods for web, web-background, redis, and rserve, then re-run this mode before remediation."
    echo "- no_explicit_blocker_detected: capture another snapshot after one interval window and compare queue/job/datapoint drift for hidden intermittent blockers."
    echo
    echo "## Artifacts"
    echo
    echo "- Detail JSON: $(basename "$detail_json")"
    echo "- Job inventory JSON: $(basename "$job_inventory_json")"
    echo "- Job inventory TSV: $(basename "$job_inventory_tsv")"
    echo "- Candidate TSV: $(basename "$candidates_tsv")"
    echo "- Baseline signals: $(basename "$baseline_json")"
    echo "- Queue depths: queue_depths.txt"
    echo "- Failed queue triage: failed_queue_triage.md"
    echo "- Failed queue signatures: failed_queue_signature_counts.tsv"
    echo "- Failed queue by analysis: failed_queue_analysis_counts.tsv"
    echo "- Problem pod counts: problem_pod_counts.txt"
    echo "- Warning events: warning_events_recent.tsv"
  } > "$summary_md"

  log "Review complete: ${summary_md}"
  log "Detail JSON: ${detail_json}"
}

collect_scale_metrics_line() {
  local timeline_file="$1"
  local iso ts hpa_current hpa_desired deploy_desired deploy_current deploy_available node_total node_ready
  local redis_pod queue_simulations queue_requeued worker_hpa
  iso="$(date -Iseconds)"
  ts="$(date +%s)"
  worker_hpa="$(get_worker_hpa_name)"

  hpa_current="$(kubectl -n "$NAMESPACE" get hpa "$worker_hpa" -o jsonpath='{.status.currentReplicas}' 2>/dev/null || true)"
  hpa_desired="$(kubectl -n "$NAMESPACE" get hpa "$worker_hpa" -o jsonpath='{.status.desiredReplicas}' 2>/dev/null || true)"
  deploy_desired="$(kubectl -n "$NAMESPACE" get deploy worker -o jsonpath='{.spec.replicas}' 2>/dev/null || true)"
  deploy_current="$(kubectl -n "$NAMESPACE" get deploy worker -o jsonpath='{.status.replicas}' 2>/dev/null || true)"
  deploy_available="$(kubectl -n "$NAMESPACE" get deploy worker -o jsonpath='{.status.availableReplicas}' 2>/dev/null || true)"
  node_total="$(kubectl get nodes --no-headers 2>/dev/null | wc -l | xargs || true)"
  node_ready="$(kubectl get nodes --no-headers 2>/dev/null | awk '$2 ~ /^Ready/ {c++} END{print c+0}' || true)"

  queue_simulations="na"
  queue_requeued="na"
  if redis_pod="$(get_redis_pod 2>/dev/null)"; then
    queue_simulations="$(kubectl -n "$NAMESPACE" exec "$redis_pod" -- sh -lc '
      PW="${REDIS_PASSWORD:-}"
      AUTH=""
      if [ -n "$PW" ]; then AUTH="-a $PW --no-auth-warning"; fi
      redis-cli $AUTH LLEN resque:queue:simulations
    ' 2>/dev/null | tr -d '\r' || true)"
    queue_requeued="$(kubectl -n "$NAMESPACE" exec "$redis_pod" -- sh -lc '
      PW="${REDIS_PASSWORD:-}"
      AUTH=""
      if [ -n "$PW" ]; then AUTH="-a $PW --no-auth-warning"; fi
      redis-cli $AUTH LLEN resque:queue:requeued
    ' 2>/dev/null | tr -d '\r' || true)"
  fi

  : "${hpa_current:=na}"
  : "${hpa_desired:=na}"
  : "${deploy_desired:=na}"
  : "${deploy_current:=na}"
  : "${deploy_available:=na}"
  : "${node_total:=na}"
  : "${node_ready:=na}"
  : "${queue_simulations:=na}"
  : "${queue_requeued:=na}"
  printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" \
    "$iso" "$ts" "$hpa_current" "$hpa_desired" "$deploy_desired" "$deploy_current" "$deploy_available" "$node_ready" "$node_total" "${queue_simulations},${queue_requeued}" \
    >> "$timeline_file"
}

run_scale_baseline_mode() {
  local root_dir start_epoch now elapsed sample_idx sample_ts sample_dir original_snapshot_dir timeline_file
  [[ "$BASELINE_DURATION_SECONDS" =~ ^[0-9]+$ ]] || die "--duration-seconds must be an integer"
  [[ "$BASELINE_INTERVAL_SECONDS" =~ ^[0-9]+$ ]] || die "--interval-seconds must be an integer"
  (( BASELINE_DURATION_SECONDS >= BASELINE_INTERVAL_SECONDS )) || die "--duration-seconds must be >= --interval-seconds"
  (( BASELINE_INTERVAL_SECONDS >= 5 )) || die "--interval-seconds must be >= 5"
  if [[ "$CLEANUP_FAILED_WORKER_PODS" == "true" && "$APPLY" != "true" ]]; then
    die "--cleanup-failed-worker-pods requires --apply"
  fi

  root_dir="${SNAPSHOT_DIR:-./incident-snapshots/${RELEASE}-scale-baseline-$(date +%Y%m%d-%H%M%S)}"
  mkdir -p "$root_dir"
  timeline_file="${root_dir}/scale_timeline.tsv"
  printf "timestamp_iso\ttimestamp_epoch\thpa_current\thpa_desired\tdeploy_desired\tdeploy_current\tdeploy_available\tnodes_ready\tnodes_total\tqueues_simulations_requeued\n" > "$timeline_file"
  printf "duration_seconds=%s\ninterval_seconds=%s\nnamespace=%s\nrelease=%s\n" \
    "$BASELINE_DURATION_SECONDS" "$BASELINE_INTERVAL_SECONDS" "$NAMESPACE" "$RELEASE" > "${root_dir}/baseline_config.txt"

  start_epoch="$(date +%s)"
  sample_idx=0
  original_snapshot_dir="${SNAPSHOT_DIR:-}"
  while true; do
    now="$(date +%s)"
    elapsed="$((now - start_epoch))"
    if (( elapsed > BASELINE_DURATION_SECONDS )); then
      break
    fi

    sample_ts="$(date +%Y%m%d-%H%M%S)"
    sample_dir="${root_dir}/sample-$(printf '%04d' "$sample_idx")-${sample_ts}"
    log "Scale baseline sample ${sample_idx} at +${elapsed}s -> ${sample_dir}"
    if [[ "$CLEANUP_FAILED_WORKER_PODS" == "true" ]]; then
      cleanup_failed_worker_pod_artifacts
    fi
    SNAPSHOT_DIR="$sample_dir"
    run_snapshot_mode
    collect_scale_metrics_line "$timeline_file"
    if ! check_scale_up_blockers; then
      printf "blocked_at=%s\nreason=%s\n" "$(date -Iseconds)" "node health, pod regressions, or recent cluster churn" > "${root_dir}/scale_blocked.txt"
      log "Scale baseline halted: node health, pod regressions, or recent cluster churn were detected"
      return 1
    fi
    sample_idx=$((sample_idx + 1))
    sleep "$BASELINE_INTERVAL_SECONDS"
  done
  SNAPSHOT_DIR="$original_snapshot_dir"

  log "Scale baseline complete: ${root_dir}"
  log "Timeline: ${timeline_file}"
}

run_ceiling_probe_mode() {
  local start_epoch now elapsed samples_total samples_pass samples_blocked
  local hard_blocker_samples queue_blockers_total core_blockers_total
  local queue_blockers core_blockers sample_blockers current_max suggested_next_max recommendation reason
  local hold_reason_codes sample_reason_codes sample_timestamp root_dir
  local blocked_snapshot_taken

  [[ "$QUIET_WINDOW_SECONDS" =~ ^[0-9]+$ ]] || die "--quiet-window-seconds must be an integer"
  [[ "$QUIET_WINDOW_INTERVAL_SECONDS" =~ ^[0-9]+$ ]] || die "--quiet-interval-seconds must be an integer"
  [[ "$PROBE_STEP_REPLICAS" =~ ^[0-9]+$ ]] || die "--probe-step-replicas must be an integer"
  [[ "$EVENT_WINDOW_SECONDS" =~ ^[0-9]+$ ]] || die "--event-window-seconds must be an integer"
  [[ "$EVENT_HARD_BLOCKER_THRESHOLD" =~ ^[0-9]+$ ]] || die "--event-hard-threshold must be an integer"
  [[ "$EVENT_SOFT_BLOCKER_THRESHOLD" =~ ^[0-9]+$ ]] || die "--event-soft-threshold must be an integer"
  [[ "$PROBLEM_POD_BLOCKER_THRESHOLD" =~ ^[0-9]+$ ]] || die "--problem-pod-threshold must be an integer"
  [[ "$CALICO_QOS_NON_GUARANTEED_THRESHOLD" =~ ^[0-9]+$ ]] || die "--calico-qos-threshold must be an integer"
  [[ "$STALE_TERMINATING_MINUTES" =~ ^[0-9]+$ ]] || die "--stale-terminating-minutes must be an integer"
  [[ "$PERSISTENT_BLOCKER_SNAPSHOT_THRESHOLD" =~ ^[0-9]+$ ]] || die "persistent blocker snapshot threshold must be an integer"
  (( QUIET_WINDOW_SECONDS >= QUIET_WINDOW_INTERVAL_SECONDS )) || die "--quiet-window-seconds must be >= --quiet-interval-seconds"
  (( QUIET_WINDOW_INTERVAL_SECONDS >= 5 )) || die "--quiet-interval-seconds must be >= 5"
  (( PROBE_STEP_REPLICAS >= 1 )) || die "--probe-step-replicas must be >= 1"
  (( EVENT_WINDOW_SECONDS >= 60 )) || die "--event-window-seconds must be >= 60"
  (( EVENT_HARD_BLOCKER_THRESHOLD >= 1 )) || die "--event-hard-threshold must be >= 1"
  (( EVENT_SOFT_BLOCKER_THRESHOLD >= 1 )) || die "--event-soft-threshold must be >= 1"
  (( PROBLEM_POD_BLOCKER_THRESHOLD >= 1 )) || die "--problem-pod-threshold must be >= 1"
  (( CALICO_QOS_NON_GUARANTEED_THRESHOLD >= 1 )) || die "--calico-qos-threshold must be >= 1"
  (( STALE_TERMINATING_MINUTES >= 1 )) || die "--stale-terminating-minutes must be >= 1"
  (( PERSISTENT_BLOCKER_SNAPSHOT_THRESHOLD >= 1 )) || die "persistent blocker snapshot threshold must be >= 1"
  if [[ -n "$PROBE_MAX_REPLICAS_LIMIT" ]]; then
    [[ "$PROBE_MAX_REPLICAS_LIMIT" =~ ^[0-9]+$ ]] || die "--probe-max-replicas-limit must be an integer"
    (( PROBE_MAX_REPLICAS_LIMIT >= 1 )) || die "--probe-max-replicas-limit must be >= 1"
  fi
  if [[ "$CLEANUP_FAILED_WORKER_PODS" == "true" && "$APPLY" != "true" ]]; then
    die "--cleanup-failed-worker-pods requires --apply"
  fi
  if [[ "$CLEANUP_STALE_TERMINATING_WORKER_PODS" == "true" && "$APPLY" != "true" ]]; then
    die "--cleanup-stale-terminating-worker-pods requires --apply"
  fi

  current_max="$(get_worker_hpa_spec_max_replicas)"
  [[ "$current_max" =~ ^[0-9]+$ ]] || die "Could not read worker HPA spec.maxReplicas"
  suggested_next_max=$((current_max + PROBE_STEP_REPLICAS))
  if [[ -n "$PROBE_MAX_REPLICAS_LIMIT" ]] && (( suggested_next_max > PROBE_MAX_REPLICAS_LIMIT )); then
    suggested_next_max="$PROBE_MAX_REPLICAS_LIMIT"
  fi

  samples_total=0
  samples_pass=0
  samples_blocked=0
  hard_blocker_samples=0
  queue_blockers_total=0
  core_blockers_total=0
  hold_reason_codes=""
  blocked_snapshot_taken=false
  root_dir="${SNAPSHOT_DIR:-./incident-snapshots/${RELEASE}-ceiling-probe-$(date +%Y%m%d-%H%M%S)}"
  start_epoch="$(date +%s)"

  while true; do
    now="$(date +%s)"
    elapsed="$((now - start_epoch))"
    if (( elapsed > QUIET_WINDOW_SECONDS )); then
      break
    fi

    if [[ "$CLEANUP_FAILED_WORKER_PODS" == "true" ]]; then
      cleanup_failed_worker_pod_artifacts
    fi

    sample_blockers=0
    sample_reason_codes=""
    sample_timestamp="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    if ! check_scale_up_blockers; then
      hard_blocker_samples=$((hard_blocker_samples + 1))
      sample_blockers=$((sample_blockers + 1))
      sample_reason_codes="$(merge_queue_csv "$sample_reason_codes" "$LAST_BLOCKER_REASON_CODES")"
    fi

    queue_blockers="$(count_queue_pipeline_blockers)"
    core_blockers="$(count_core_service_readiness_blockers)"
    [[ "$queue_blockers" =~ ^[0-9]+$ ]] || queue_blockers=1
    [[ "$core_blockers" =~ ^[0-9]+$ ]] || core_blockers=1

    queue_blockers_total=$((queue_blockers_total + queue_blockers))
    core_blockers_total=$((core_blockers_total + core_blockers))
    sample_blockers=$((sample_blockers + queue_blockers + core_blockers))
    if (( queue_blockers > 0 )); then
      sample_reason_codes="$(merge_queue_csv "$sample_reason_codes" "queue_pipeline_blocked")"
    fi
    if (( core_blockers > 0 )); then
      sample_reason_codes="$(merge_queue_csv "$sample_reason_codes" "core_service_readiness_blocked")"
    fi

    if (( sample_blockers == 0 )); then
      samples_pass=$((samples_pass + 1))
    else
      samples_blocked=$((samples_blocked + 1))
      hold_reason_codes="$(merge_queue_csv "$hold_reason_codes" "$sample_reason_codes")"
      if [[ "$CLEANUP_STALE_TERMINATING_WORKER_PODS" == "true" && "$sample_reason_codes" == *"stale_terminating_high"* ]]; then
        cleanup_stale_terminating_worker_pods
      fi
      if [[ "$SNAPSHOT_ON_BLOCK" == "true" && "$blocked_snapshot_taken" == "false" && "$samples_blocked" -ge "$PERSISTENT_BLOCKER_SNAPSHOT_THRESHOLD" ]]; then
        mkdir -p "$root_dir"
        SNAPSHOT_DIR="${root_dir}/blocked-snapshot-${sample_timestamp//[:]/}"
        run_snapshot_mode
        blocked_snapshot_taken=true
      fi
    fi
    samples_total=$((samples_total + 1))

    if [[ "$PROBE_DIAGNOSTICS" == "true" ]]; then
      sample_reason_codes="$(normalize_hold_reason_codes "$sample_reason_codes")"
      echo "SAMPLE_DIAGNOSTIC sample=${samples_total} timestamp=${sample_timestamp} blocked=${sample_blockers} node_blockers=${LAST_NODE_BLOCKERS} problem_pods=${LAST_PROBLEM_PODS} stale_terminating=${LAST_STALE_TERMINATING_PODS} hard_events=${LAST_HARD_EVENT_COUNT} soft_events=${LAST_SOFT_EVENT_COUNT} platform_pod_sandbox_network=${LAST_PLATFORM_POD_SANDBOX_NETWORK_COUNT} platform_image_pull_auth=${LAST_PLATFORM_IMAGE_PULL_AUTH_COUNT} platform_external_metric=${LAST_PLATFORM_EXTERNAL_METRIC_COUNT} calico_qos_non_guaranteed=${LAST_CALICO_QOS_NON_GUARANTEED} calico_qos_cr_hardened=${LAST_CALICO_QOS_CR_HARDENED} queue_blockers=${queue_blockers} core_blockers=${core_blockers} event_window_start=${LAST_EVENT_WINDOW_START_ISO} event_window_end=${LAST_EVENT_WINDOW_END_ISO} reason_codes=${sample_reason_codes:-none}"
    fi

    sleep "$QUIET_WINDOW_INTERVAL_SECONDS"
  done

  recommendation="advance"
  reason="quiet-window gates passed"
  if [[ -n "$PROBE_MAX_REPLICAS_LIMIT" ]] && (( current_max >= PROBE_MAX_REPLICAS_LIMIT )); then
    recommendation="hold"
    reason="current maxReplicas already at probe limit"
    hold_reason_codes="$(merge_queue_csv "$hold_reason_codes" "probe_limit_reached")"
  elif (( samples_blocked > 0 )) || (( hard_blocker_samples > 0 )) || (( queue_blockers_total > 0 )) || (( core_blockers_total > 0 )); then
    recommendation="hold"
    reason="quiet-window blockers met thresholded hold policy"
  fi
  hold_reason_codes="$(normalize_hold_reason_codes "$hold_reason_codes")"

  log "Ceiling probe summary (report-only): recommendation=${recommendation}"
  echo "PROBE_MODE=report-only"
  echo "RECOMMENDATION=${recommendation}"
  echo "REASON=${reason}"
  echo "CURRENT_MAX_REPLICAS=${current_max}"
  echo "STEP_REPLICAS=${PROBE_STEP_REPLICAS}"
  echo "SUGGESTED_NEXT_MAX_REPLICAS=${suggested_next_max}"
  echo "PROBE_MAX_REPLICAS_LIMIT=${PROBE_MAX_REPLICAS_LIMIT}"
  echo "FAILED_WORKER_POD_CLEANUP=${CLEANUP_FAILED_WORKER_PODS}"
  echo "QUIET_WINDOW_SECONDS=${QUIET_WINDOW_SECONDS}"
  echo "QUIET_INTERVAL_SECONDS=${QUIET_WINDOW_INTERVAL_SECONDS}"
  echo "SAMPLES_TOTAL=${samples_total}"
  echo "SAMPLES_PASS=${samples_pass}"
  echo "SAMPLES_BLOCKED=${samples_blocked}"
  echo "HARD_BLOCKER_SAMPLES=${hard_blocker_samples}"
  echo "QUEUE_BLOCKERS_TOTAL=${queue_blockers_total}"
  echo "CORE_SERVICE_BLOCKERS_TOTAL=${core_blockers_total}"
  echo "EVENT_WINDOW_SECONDS=${EVENT_WINDOW_SECONDS}"
  echo "EVENT_HARD_THRESHOLD=${EVENT_HARD_BLOCKER_THRESHOLD}"
  echo "EVENT_SOFT_THRESHOLD=${EVENT_SOFT_BLOCKER_THRESHOLD}"
  echo "PROBLEM_POD_THRESHOLD=${PROBLEM_POD_BLOCKER_THRESHOLD}"
  echo "CALICO_QOS_THRESHOLD=${CALICO_QOS_NON_GUARANTEED_THRESHOLD}"
  echo "STALE_TERMINATING_MINUTES=${STALE_TERMINATING_MINUTES}"
  echo "HOLD_REASON_CODES=${hold_reason_codes:-none}"
  print_hold_reason_mapping "$hold_reason_codes"
}

run_reconcile_mode() {
  [[ "$APPLY" == "true" ]] || die "Refusing to mutate without --apply"
  [[ "$ALLOW_CHART_APPLY" == "true" ]] || die "Refusing local chart upgrade without --allow-chart-apply"
  require_release_exists

  log "Running preflight dry-run for ${RELEASE}/${NAMESPACE}"
  helm upgrade "$RELEASE" "$CHART_DIR" \
    -n "$NAMESPACE" \
    --reuse-values \
    --server-side=false \
    --dry-run=server >/dev/null

  if [[ "$ALLOW_NON_CONFLICT_RECONCILE" != "true" ]] && ! reconcile_is_conflict_failure; then
    die "Release is not in a known managed-field conflict failure; use --allow-non-conflict-reconcile to override"
  fi

  log "Reconciling Helm release ${RELEASE} in ${NAMESPACE} with client-side apply"
  helm upgrade "$RELEASE" "$CHART_DIR" \
    -n "$NAMESPACE" \
    --reuse-values \
    --server-side=false \
    --description "Reconcile release after managed-field conflicts"
  log "Reconcile complete. Current status:"
  helm status "$RELEASE" -n "$NAMESPACE" | sed -n '1,20p'
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--namespace)
      NAMESPACE="$2"; shift 2 ;;
    -r|--release)
      RELEASE="$2"; shift 2 ;;
    -c|--chart)
      CHART_DIR="$2"; shift 2 ;;
    --mode)
      MODE="$2"; shift 2 ;;
    --snapshot-dir)
      SNAPSHOT_DIR="$2"; shift 2 ;;
    --apply)
      APPLY=true; shift ;;
    --no-strict)
      STRICT=false; shift ;;
    --allow-chart-apply)
      ALLOW_CHART_APPLY=true; shift ;;
    --allow-non-conflict-reconcile)
      ALLOW_NON_CONFLICT_RECONCILE=true; shift ;;
    --stale-minutes)
      STALE_THRESHOLD_MINUTES="$2"; shift 2 ;;
    --lock-ttl-seconds)
      RECOVERY_LOCK_TTL_SECONDS="$2"; shift 2 ;;
    --duration-seconds)
      BASELINE_DURATION_SECONDS="$2"; shift 2 ;;
    --interval-seconds)
      BASELINE_INTERVAL_SECONDS="$2"; shift 2 ;;
    --quiet-window-seconds)
      QUIET_WINDOW_SECONDS="$2"; shift 2 ;;
    --quiet-interval-seconds)
      QUIET_WINDOW_INTERVAL_SECONDS="$2"; shift 2 ;;
    --probe-step-replicas)
      PROBE_STEP_REPLICAS="$2"; shift 2 ;;
    --probe-max-replicas-limit)
      PROBE_MAX_REPLICAS_LIMIT="$2"; shift 2 ;;
    --event-window-seconds)
      EVENT_WINDOW_SECONDS="$2"; shift 2 ;;
    --event-hard-threshold)
      EVENT_HARD_BLOCKER_THRESHOLD="$2"; shift 2 ;;
    --event-soft-threshold)
      EVENT_SOFT_BLOCKER_THRESHOLD="$2"; shift 2 ;;
    --problem-pod-threshold)
      PROBLEM_POD_BLOCKER_THRESHOLD="$2"; shift 2 ;;
    --calico-qos-threshold)
      CALICO_QOS_NON_GUARANTEED_THRESHOLD="$2"; shift 2 ;;
    --stale-terminating-minutes)
      STALE_TERMINATING_MINUTES="$2"; shift 2 ;;
    --probe-diagnostics)
      PROBE_DIAGNOSTICS=true; shift ;;
    --snapshot-on-block)
      SNAPSHOT_ON_BLOCK=true; shift ;;
    --cleanup-failed-worker-pods)
      CLEANUP_FAILED_WORKER_PODS=true; shift ;;
    --cleanup-max-delete)
      CLEANUP_MAX_DELETE="$2"; shift 2 ;;
    --cleanup-stale-terminating-worker-pods)
      CLEANUP_STALE_TERMINATING_WORKER_PODS=true; shift ;;
    --cleanup-stale-max-delete)
      CLEANUP_STALE_MAX_DELETE="$2"; shift 2 ;;
    --analysis-id)
      ANALYSIS_ID="$2"; shift 2 ;;
    -h|--help)
      usage; exit 0 ;;
    *)
      die "Unknown argument: $1" ;;
  esac
done

require_bin kubectl
require_bin helm
require_bin jq

case "$MODE" in
  check) run_check_mode ;;
  snapshot) run_snapshot_mode ;;
  review-non-completed) run_review_non_completed_mode ;;
  scale-baseline) run_scale_baseline_mode ;;
  ceiling-probe) run_ceiling_probe_mode ;;
  reconcile-helm) run_reconcile_mode ;;
  recover-stuck) recover_stuck_state ;;
  *) die "Unsupported mode: $MODE" ;;
esac
